{"id": "AR51_008:K020", "doan": "فقدوا"}
{"id": "AR51_008:K021", "doan": "النحيف"}
{"id": "AR51_008:K022", "doan": "تى القيثارة المتعددة الأوتار، تلك القيثارة التي"}
{"id": "AR51_008:K023", "doan": "وذنبته آيات وحيرة، وذهب هؤلاء"}
{"id": "AR51_008:K024", "doan": "وانت"}
{"id": "AR51_008:K025", "doan": "الذي"}
{"id": "AR51_008:K026", "doan": "سحرها، ولكن هوميروس ابتها\""}
{"id": "AR51_008:K027", "doan": "ومعه الاَّ"}
{"id": "AR51_008:K028", "doan": "وكان مسكين"}
{"id": "AR53_02_213:K000", "doan": "وذمهم كانوا مؤمنين، فذكروا معرفة"}
{"id": "AR53_02_213:K001", "doan": "الآن بقادتهم والزعماء، وفاضوا المعارك متتغنين أن"}
{"id": "AR53_02_213:K002", "doan": "وهي هواشها والمغرب، وإن في تحقيق مبادئ الثورة تحقيق"}
{"id": "AR53_02_213:K003", "doan": "بيان"}
{"id": "AR53_02_213:K004", "doan": "شريدي"}
{"id": "AR53_02_213:K005", "doan": "مطالبهم الوطنية وآمالهم القومية"}
{"id": "AR53_02_213:K006", "doan": "والجبرية وما يلزم هو ايفاء الاسماء"}
{"id": "AR53_02_213:K007", "doan": "العامل القوة التي كونت الثورة، وضمنت لها النصر. فقد تصور"}
{"id": "AR53_02_213:K008", "doan": "آية أن الجهميين أعداء النبأ وأعداء الله، وان"}
{"id": "AR53_02_213:K009", "doan": "دور عن"}
{"id": "AR53_02_213:K010", "doan": "كما في"}
{"id": "AR53_02_213:K011", "doan": "ينصار على اللفظ والإلحاد. إن في د"}
{"id": "AR53_02_213:K012", "doan": "الثوار، وصوّروا"}
{"id": "AR53_02_213:K013", "doan": "من الدعايات السياسية في هذا الزمان"}
{"id": "AR53_02_213:K014", "doan": "الإنتقاد على"}
{"id": "AR53_02_213:K015", "doan": "على دعاية"}
{"id": "AR53_02_213:K016", "doan": "فيه"}
{"id": "AR53_02_213:K017", "doan": "الوهم أو اختراع"}
{"id": "AR53_02_213:K018", "doan": "بنية"}
{"id": "AR53_02_213:K019", "doan": "أن للنفاق"}
{"id": "AR53_02_213:K020", "doan": "الساعة ١٢ من تلك الليلة والساعة ١ من تلك الليلة"}
{"id": "AR53_02_213:K021", "doan": "نعود الى جلتنا القبيه،"}
{"id": "AR53_02_213:K022", "doan": "عطف به، بداية ونهاية ومتى"}
{"id": "AR53_02_213:K023", "doan": "ينظر فينا بعد"}
{"id": "AR53_02_213:K024", "doan": "ظهر بعضها، والأمل كبير"}
{"id": "AR53_02_213:K025", "doan": "قطعنا جبال غمارة"}
{"id": "AR53_02_213:K026", "doan": "تقصي على الفا"}
{"id": "AR53_02_213:K027", "doan": "٢ -"}
{"id": "AR53_02_213:K028", "doan": "٢)"}
{"id": "AR53_02_213:K029", "doan": "بدأ الانزع، و"}
{"id": "AR53_02_213:K030", "doan": "الى اولئك على"}
{"id": "AR53_02_213:K031", "doan": "الاحد"}
{"id": "AR53_02_213:K032", "doan": "فعاد إلى قان بناء"}
{"id": "AR53_02_213:K033", "doan": "تعود الى المعلمة الفنية"}
{"id": "AR53_02_213:K034", "doan": "في هذه الأسماء"}
{"id": "AR53_02_213:K035", "doan": "١١٠"}
{"id": "AR53_02_213:K036", "doan": "ومن والبدات"}
{"id": "AR53_02_213:K037", "doan": "3"}
{"id": "AR53_02_213:K038", "doan": "والتقية"}
{"id": "AR53_02_213:K039", "doan": "الشائع أنها رسمية"}
{"id": "AR53_02_213:K040", "doan": "بتاعه - زوقت -"}
