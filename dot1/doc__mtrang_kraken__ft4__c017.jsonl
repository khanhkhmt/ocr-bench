{"id": "MeM1C_10_02:K017", "doan": "تكون شفعة هذا الموقف وملتمسة له من بها الجيب المجازاة الحسنة"}
{"id": "MeM1C_10_02:K018", "doan": "عوضا عن هذا الخير القاصد أن يبديه مجد الله وإفادة للغريب ولكني"}
{"id": "MeM1C_10_02:K019", "doan": "كثرة هذا الناسين نافذا وثابتا ومعلوما عند نحو ارتقاؤنا به"}
{"id": "MeM1C_10_02:K020", "doan": "قد تحررت هذه الخط بيد بولس المذكور تحريرا في ٦ تموز سنة ١٨٤٠ الف وثم أبى"}
{"id": "MeM1C_10_02:K021", "doan": "وسبع وثلاثين"}
{"id": "Nasrallah-Al001-014f:K000", "doan": "٠"}
{"id": "Nasrallah-Al001-014f:K001", "doan": "الى الثمن\"."}
{"id": "Nasrallah-Al001-014f:K002", "doan": "أما الصورة التي افقتها، ولم"}
{"id": "Nasrallah-Al001-014f:K003", "doan": "غاً: فهي صورة أمها، \"فامتها"}
{"id": "Nasrallah-Al001-014f:K004", "doan": "المخطاطة بالعود \"حـ ١\" صفتها"}
{"id": "Nasrallah-Al001-014f:K005", "doan": "عة"}
{"id": "Nasrallah-Al001-014f:K006", "doan": "لقد سطت على قرائتها"}
{"id": "Nasrallah-Al001-014f:K007", "doan": "صبو"}
{"id": "Nasrallah-Al001-014f:K008", "doan": "لا سهل على أيّ طالب وصفها،"}
{"id": "Nasrallah-Al001-014f:K009", "doan": "الثقافة التي اعتمد عليها، وكما سماها"}
{"id": "Nasrallah-Al001-014f:K010", "doan": "بدله، حاول أن يخفف من أثقال"}
{"id": "Nasrallah-Al001-014f:K011", "doan": "طعولةً فلقه، حامق، وحاملة"}
{"id": "Nasrallah-Al001-014f:K012", "doan": "جبل من الو سلة الغامضه"}
{"id": "Nasrallah-Al001-014f:K013", "doan": "ولم يكن سطحه عليها"}
{"id": "Nasrallah-Al001-014f:K014", "doan": "ان يوم طفولتها، في المراة العالة"}
{"id": "Nasrallah-Al001-014f:K015", "doan": "لما فيها : د نهري، المشهوة بالحراة"}
{"id": "Nasrallah-Al001-014f:K016", "doan": "والبصرة."}
{"id": "Nasrallah-Al001-014h:K000", "doan": "فمنها، ثم انجزت ٥٠٠  . .  مثلث"}
{"id": "Nasrallah-Al001-014h:K001", "doan": "احى"}
{"id": "Nasrallah-Al001-014h:K002", "doan": "لكن ليلى عمران لم تفشل في"}
{"id": "Nasrallah-Al001-014h:K003", "doan": "مسرتها الأدبية، وقد خلقت من بعدها"}
{"id": "Nasrallah-Al001-014h:K004", "doan": "عشر روايات بدءا من العام 1960 حين"}
{"id": "Nasrallah-Al001-014h:K005", "doan": "ز - ر - روايتها الأولى \"لن يموت عدا\""}
{"id": "Nasrallah-Al001-014h:K006", "doan": "أبناء كتاب \"الغيوم\" وهو عملٌ"}
{"id": "Nasrallah-Al001-014h:K007", "doan": "مريدى ادنا الحديث ؛ كما ان المؤلفة"}
{"id": "Nasrallah-Al001-014h:K008", "doan": "تقدمت برأيها وولوها الى مواطن"}
{"id": "Nasrallah-Al001-014h:K009", "doan": "الآن الإنساني المتألم، والذي"}
{"id": "Nasrallah-Al001-014h:K010", "doan": "كأنسه الى حب"}
{"id": "Nasrallah-Al001-014h:K011", "doan": "وإلاصنا مع العلماء"}
{"id": "Nasrallah-Al001-014h:K012", "doan": "لم تدع تلك التجربة الإنسانية الفريدة"}
