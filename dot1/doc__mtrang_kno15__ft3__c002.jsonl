{"id": "AR53_02_213:K041", "doan": "v"}
{"id": "AR53_02_213:K042", "doan": "مالوقه"}
{"id": "AR53_02_213:K043", "doan": "٤"}
{"id": "AR53_02_213:K044", "doan": "٢\""}
{"id": "AR53_02_213:K045", "doan": "بما من لغة معروفة"}
{"id": "AR53_02_213:K046", "doan": "عن الوحدة الى"}
{"id": "AR53_02_213:K047", "doan": "وهذا"}
{"id": "AR53_02_213:K048", "doan": "ثلاث مساكن -"}
{"id": "AR53_02_213:K049", "doan": "الزوجية"}
{"id": "AR53_02_213:K050", "doan": "تبعد العياء عن العياء"}
{"id": "AR53_02_213:K051", "doan": "القبيات"}
{"id": "AR53_02_213:K052", "doan": "غير الوغة"}
{"id": "AR53_02_213:K053", "doan": "برهان"}
{"id": "AR53_02_213:K054", "doan": "بضاعة أو اغريق"}
{"id": "AR53_02_213:K055", "doan": "و"}
{"id": "AR53_02_213:K056", "doan": "٥"}
{"id": "AR53_02_213:K057", "doan": "ذووي"}
{"id": "AR53_02_213:K058", "doan": "الى سرء"}
{"id": "AR53_02_213:K059", "doan": "ج"}
{"id": "AR53_02_213:K060", "doan": "متحوف"}
{"id": "AR53_02_213:K061", "doan": "نفوذ"}
{"id": "AR53_02_213:K062", "doan": "وغيرنا"}
{"id": "AR53_02_213:K063", "doan": "الياء والسين"}
{"id": "AR56_01_078_2:K000", "doan": "،     مهلاً مهلاً مهلاً"}
{"id": "AR56_01_078_2:K001", "doan": "زيارة زحله ومعرفها ولا يجدر بك"}
{"id": "AR56_01_078_2:K002", "doan": "الباطن الا راد هذا شيء"}
{"id": "AR56_01_078_2:K003", "doan": "الصغير من دلائل الحياة في بلادك."}
{"id": "AR56_01_078_2:K004", "doan": "من افهم ما معنى عموم كتابك"}
{"id": "AR56_01_078_2:K005", "doan": "في المدافن، أعاطيك مني اثنى"}
{"id": "AR56_01_078_2:K006", "doan": "الدرس مبادئك؟ وعهدي بك"}
{"id": "AR56_01_078_2:K007", "doan": "ارفع المندن واسلم إلى البحث."}
{"id": "AR56_01_078_2:K008", "doan": "قيل لي ان المستشفى يتكلمك فك"}
{"id": "AR56_01_078_2:K009", "doan": "وكنت عابسا في الجبل فلم أتمكن"}
{"id": "AR56_01_078_2:K010", "doan": "من الاطلاع ما تخرصوا في"}
{"id": "AR56_01_078_2:K011", "doan": "٢"}
{"id": "AR56_01_078_2:K012", "doan": "ولكنه اشدة للامام وسوق"}
{"id": "AR56_01_078_2:K013", "doan": "ترك ما يفيد الكلام لولا"}
{"id": "AR56_01_078_2:K014", "doan": "الفراد"}
{"id": "AR56_01_078_2:K015", "doan": "الملك بشرف على اس اس"}
{"id": "AR56_01_078_2:K016", "doan": "الرقة والرؤية فهذه"}
{"id": "AR56_01_078_2:K017", "doan": "ارسله لحضره فصل الى"}
{"id": "AR56_01_078_2:K018", "doan": "الادارة وهي تسير الى"}
{"id": "AR56_03_036:K000", "doan": "ثم إن الحرم"}
{"id": "AR56_03_036:K001", "doan": "من عبد العزيز بن عبد الرحمن الفيصل إلى حضرة المكرم الاستاذ أمين افندي الريحاني المحترم دام بقاه"}
{"id": "AR56_03_036:K002", "doan": "تحية وسلاما وبعد فقد أخذت بيد المسير كتابك المؤرخ ١٤٤٢ وأني اشكرك على هذه ثقتك بنا"}
{"id": "AR56_03_036:K003", "doan": "كما أشكرك على خدماتك لقومك بكل ما تستطيع، أما صداقتي الطاهرة التي تعرفها بأأمن لم تتغير وبقدر هذه"}
{"id": "AR56_03_036:K004", "doan": "الصداقة كان العتب إنك تعرفنا يا أمين وتعرف جنودنا أن عزا ثمنا لا يفعلها"}
{"id": "AR56_03_036:K005", "doan": "إلا إرادة الله، فما معنى تخفيفنا بجمع علي وجيشه، إننا لم نقصد من نشر الكتاب الحط من شأنك ولا النيل"}
{"id": "AR56_03_036:K006", "doan": "من كرامتك ولكن أردنا أن تعرف ويعرف العالم القاصي والداني أن القوم لا يملكون إلا كلمات ممجوفة وإن ما جمعوا"}
{"id": "AR56_03_036:K007", "doan": "لن يقف بحول الله وقوته أمام جند الله لقد فتحت لك قلبي يا أمي في كتابي المرسل مع العويني ولكنك استعملت"}
