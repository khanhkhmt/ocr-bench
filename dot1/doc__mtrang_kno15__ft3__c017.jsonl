{"id": "MeM1C_10_02:K017", "doan": "تكون شفية هذا الموقف وملتهة له من ابنها الجيب المجازاة الحسنة"}
{"id": "MeM1C_10_02:K018", "doan": "عوضا عن هذا الخر القاصد أن يبديه مجد الله وإفادة للغريب ولكني"}
{"id": "MeM1C_10_02:K019", "doan": "يكون هذا الناسين نافذا ونابتا ومعلوما عند الحميري ارتقاؤنا به"}
{"id": "MeM1C_10_02:K020", "doan": "قد تحررت هذه الخطابية بيد بولس المذكور تحيرا في ٢٨ تموز سنة ٩٣١ الف وثمانيه"}
{"id": "MeM1C_10_02:K021", "doan": "وسبع وثلاثين"}
{"id": "Nasrallah-Al001-014f:K000", "doan": "١٠"}
{"id": "Nasrallah-Al001-014f:K001", "doan": "الجاثمين\""}
{"id": "Nasrallah-Al001-014f:K002", "doan": "أما الصورة التي رافقتها، ولم"}
{"id": "Nasrallah-Al001-014f:K003", "doan": "غاً \" فهي صورة أُمكأ \" فامتها"}
{"id": "Nasrallah-Al001-014f:K004", "doan": "المخطاة بالسعود \"حسب ما نصها،"}
{"id": "Nasrallah-Al001-014f:K005", "doan": "غمة"}
{"id": "Nasrallah-Al001-014f:K006", "doan": "لقد سقطت بي لقرأتها"}
{"id": "Nasrallah-Al001-014f:K007", "doan": "هو"}
{"id": "Nasrallah-Al001-014f:K008", "doan": "لا يسهل على أيّ طالب وصفها،"}
{"id": "Nasrallah-Al001-014f:K009", "doan": "الثقافية التي اعتمدتها، وكما سماهات"}
{"id": "Nasrallah-Al001-014f:K010", "doan": "بدله، يحاول أن يخفف من أثقال"}
{"id": "Nasrallah-Al001-014f:K011", "doan": "طعولة، فلقه، حافه، وحاملة"}
{"id": "Nasrallah-Al001-014f:K012", "doan": "جبل من الوستلة العاصمة"}
{"id": "Nasrallah-Al001-014f:K013", "doan": "ولم يكن سطه عليها"}
{"id": "Nasrallah-Al001-014f:K014", "doan": "ان موافقة طفولتها، في المراة العاكسة،"}
{"id": "Nasrallah-Al001-014f:K015", "doan": "لما يلي : د نهيبها، المتشومة بالمجرأة"}
{"id": "Nasrallah-Al001-014f:K016", "doan": "والصراحة."}
{"id": "Nasrallah-Al001-014h:K000", "doan": "فبعد، ثم انجزت ٥٠٠ مئت"}
{"id": "Nasrallah-Al001-014h:K001", "doan": ": احرى"}
{"id": "Nasrallah-Al001-014h:K002", "doan": "لكن ليلى عسران لم تفشل في"}
{"id": "Nasrallah-Al001-014h:K003", "doan": "ميرتها الأديبة، وقد خلفت من بعدها"}
{"id": "Nasrallah-Al001-014h:K004", "doan": "عشر روايات بدءا من العام 1960 حين"}
{"id": "Nasrallah-Al001-014h:K005", "doan": "أ -  سوايتها الأولى \"لن يموت عدا"}
{"id": "Nasrallah-Al001-014h:K006", "doan": "واشتد \"الغيبوبة\" وهو عمل"}
{"id": "Nasrallah-Al001-014h:K007", "doan": "فريد في أدنا الحديث ؛ كما أن المؤلفة"}
{"id": "Nasrallah-Al001-014h:K008", "doan": "تقدمت بجرأتها، وولو جدًا الى مواطن"}
{"id": "Nasrallah-Al001-014h:K009", "doan": "التبان اليساف المتألم، والذي"}
{"id": "Nasrallah-Al001-014h:K010", "doan": "كأنه الى حين"}
{"id": "Nasrallah-Al001-014h:K011", "doan": "وإخلاصًا فيها لقلعها،"}
{"id": "Nasrallah-Al001-014h:K012", "doan": "لم يدع تلك التجربة الإنسانية الفريدة"}
