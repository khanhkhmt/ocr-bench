{"id": "AR51_008:K020", "doan": "فقدوا"}
{"id": "AR51_008:K021", "doan": "النحويه"}
{"id": "AR51_008:K022", "doan": "تة القيثارة المتعددة الأوتار، تلك القيثارة التي"}
{"id": "AR51_008:K023", "doan": "ردد دنية آيات وحيها، وذهب هؤلاء حواشي"}
{"id": "AR51_008:K024", "doan": "وانت"}
{"id": "AR51_008:K025", "doan": "بل الأبر،"}
{"id": "AR51_008:K026", "doan": "سحرها، ولكن هوميروس ابتها\""}
{"id": "AR51_008:K027", "doan": "ومها الا"}
{"id": "AR51_008:K028", "doan": "وكان مسكيا"}
{"id": "AR53_02_213:K000", "doan": "وأنهم كانوا موقفيين، قلت آنئذ، إن منكوب عروقة،"}
{"id": "AR53_02_213:K001", "doan": "الآمن بقادتهم والزعماء. قد خاضوا المعارك متيقنين أن"}
{"id": "AR53_02_213:K002", "doan": "الشاجر هو أيضا والغرب، وإن في تحقيق مبادئ الثورة تخفيف"}
{"id": "AR53_02_213:K003", "doan": "ديبقة"}
{"id": "AR53_02_213:K004", "doan": "شعري في"}
{"id": "AR53_02_213:K005", "doan": "مطالبهم الوطنية وآمالهم القومية،"}
{"id": "AR53_02_213:K006", "doan": "والجبرية مع ما يلزم هو أن الأسماء"}
{"id": "AR53_02_213:K007", "doan": "العامل القوي التي تولت النواة، وضمنت لها النصر. فقد قصَّر"}
{"id": "AR53_02_213:K008", "doan": "آية، إن الجهميين أعداء الله، وإن"}
{"id": "AR53_02_213:K009", "doan": "دور من"}
{"id": "AR53_02_213:K010", "doan": "كان"}
{"id": "AR53_02_213:K011", "doan": "يفار على اللفظ والإلحاد إن في ذا"}
{"id": "AR53_02_213:K012", "doan": "الثوّار، وصوتوا"}
{"id": "AR53_02_213:K013", "doan": "من الدعايات السياسية في هذا الزمان"}
{"id": "AR53_02_213:K014", "doan": "الانتقاد على"}
{"id": "AR53_02_213:K015", "doan": "على دعاية"}
{"id": "AR53_02_213:K016", "doan": "في"}
{"id": "AR53_02_213:K017", "doan": "الوهم أو اختراع"}
{"id": "AR53_02_213:K018", "doan": "تنبيه"}
{"id": "AR53_02_213:K019", "doan": "أن تتعاون"}
{"id": "AR53_02_213:K020", "doan": "وفسح لهما على مرتين في ٢٨ شباط ١٩١٢"}
{"id": "AR53_02_213:K021", "doan": "نعود الى جلتنا القبيه،"}
{"id": "AR53_02_213:K022", "doan": "عطف به، بدأية ونهاية ومتى"}
{"id": "AR53_02_213:K023", "doan": "ينظر فيا بعد"}
{"id": "AR53_02_213:K024", "doan": "ظهر بعضها، والأول كبيره"}
{"id": "AR53_02_213:K025", "doan": "قطعنا جبال غمارة"}
{"id": "AR53_02_213:K026", "doan": "تنقض على الفا"}
{"id": "AR53_02_213:K027", "doan": "٢ -"}
{"id": "AR53_02_213:K028", "doan": "٢٥"}
{"id": "AR53_02_213:K029", "doan": "في الأنبياء، و"}
{"id": "AR53_02_213:K030", "doan": "الى أوائله، على"}
{"id": "AR53_02_213:K031", "doan": "الاحد"}
{"id": "AR53_02_213:K032", "doan": "فعاد إلى قان فيها"}
{"id": "AR53_02_213:K033", "doan": "تعود إلى أهله / نقيه"}
{"id": "AR53_02_213:K034", "doan": "في هذه الأسماء"}
{"id": "AR53_02_213:K035", "doan": "١٠"}
{"id": "AR53_02_213:K036", "doan": "المن والبدات"}
{"id": "AR53_02_213:K037", "doan": "3"}
{"id": "AR53_02_213:K038", "doan": "والتغيب"}
{"id": "AR53_02_213:K039", "doan": "المتألف منها، سرية"}
{"id": "AR53_02_213:K040", "doan": "بتاعة - رزق -"}
