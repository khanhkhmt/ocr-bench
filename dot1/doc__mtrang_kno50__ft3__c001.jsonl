{"id": "AR51_008:K020", "doan": "فقدوا"}
{"id": "AR51_008:K021", "doan": "النحويه"}
{"id": "AR51_008:K022", "doan": "ت القتيارة المتعددة الأوقار، تلك القيارة التي"}
{"id": "AR51_008:K023", "doan": "ردد دينية آيات فيها، وذهب هو حواشي"}
{"id": "AR51_008:K024", "doan": "وانت"}
{"id": "AR51_008:K025", "doan": "بل الأبر،"}
{"id": "AR51_008:K026", "doan": "سمعها، ولكن هو يروي انبأً"}
{"id": "AR51_008:K027", "doan": "ومها الا"}
{"id": "AR51_008:K028", "doan": "وكان شكياً"}
{"id": "AR53_02_213:K000", "doan": "ومن آذ، لأنهم كانوا مؤمنين. قلة آمنا بفرنكو وعروته،"}
{"id": "AR53_02_213:K001", "doan": "إلا آمنا بقادتهم والزعماء. وقد خاضوا المعارك متيقنين أن"}
{"id": "AR53_02_213:K002", "doan": "القاهرة تحقيق"}
{"id": "AR53_02_213:K003", "doan": "وبيات"}
{"id": "AR53_02_213:K004", "doan": "السعودي"}
{"id": "AR53_02_213:K005", "doan": "مطالبهم الوطنية وآمالهم القومية،"}
{"id": "AR53_02_213:K006", "doan": "الجبرية وما يلزمها هو إفادة الأسماء"}
{"id": "AR53_02_213:K007", "doan": "العقول القوية التي تلونت النور، وضمنت لها النصر، فقد تصوَّر"}
{"id": "AR53_02_213:K008", "doan": "ما وية، إن الجهل بين أعداء الدنيا وأعداء الله، وإن"}
{"id": "AR53_02_213:K009", "doan": "دور عن"}
{"id": "AR53_02_213:K010", "doan": "جورج"}
{"id": "AR53_02_213:K011", "doan": "ينصار على اللفظ والألحاد إن في ذا"}
{"id": "AR53_02_213:K012", "doan": "الثأر، وصوّداً"}
{"id": "AR53_02_213:K013", "doan": "من الدعايات السياسية في هذا الزمان"}
{"id": "AR53_02_213:K014", "doan": "الإفطار على"}
{"id": "AR53_02_213:K015", "doan": "كل دعاية"}
{"id": "AR53_02_213:K016", "doan": "في"}
{"id": "AR53_02_213:K017", "doan": "الوهم أو الخداع"}
{"id": "AR53_02_213:K018", "doan": "بنية"}
{"id": "AR53_02_213:K019", "doan": "في الفقا في"}
{"id": "AR53_02_213:K020", "doan": "١"}
{"id": "AR53_02_213:K021", "doan": "نعود الى جلتنا القبيه،"}
{"id": "AR53_02_213:K022", "doan": "عطف به، بدأة ونهاية ومتى"}
{"id": "AR53_02_213:K023", "doan": "يظهر قلبان بعد"}
{"id": "AR53_02_213:K024", "doan": "ظهر بعضها، والأمل كبير"}
{"id": "AR53_02_213:K025", "doan": "قطعنا حبال غمارة"}
{"id": "AR53_02_213:K026", "doan": "تنقض على الفا"}
{"id": "AR53_02_213:K027", "doan": "٢"}
{"id": "AR53_02_213:K028", "doan": "٢)"}
{"id": "AR53_02_213:K029", "doan": "في الأنبه، و"}
{"id": "AR53_02_213:K030", "doan": "الله أو الله على"}
{"id": "AR53_02_213:K031", "doan": "الاحد"}
{"id": "AR53_02_213:K032", "doan": "فعاد إلى قان فيها"}
{"id": "AR53_02_213:K033", "doan": "تعود الى الرحلة الفنية"}
{"id": "AR53_02_213:K034", "doan": "في هذه الأكفاء"}
{"id": "AR53_02_213:K035", "doan": "الله"}
{"id": "AR53_02_213:K036", "doan": "المن والبدات،"}
{"id": "AR53_02_213:K037", "doan": "و"}
{"id": "AR53_02_213:K038", "doan": "مستقبلا"}
{"id": "AR53_02_213:K039", "doan": "فتأتى أنها رسمية"}
{"id": "AR53_02_213:K040", "doan": "ربيع ٩ - زرق"}
