{"id": "MeM1C_10_02:K017", "doan": "تكون سقيمة هذا الموقف وملتهة له من بها الحبيب المجازاة الجميلة"}
{"id": "MeM1C_10_02:K018", "doan": "عوضا عن هذا الخير القاصد أن يبديه مجد الله وإفادة للغريب ولكني"}
{"id": "MeM1C_10_02:K019", "doan": "كموة هذا الناسين باقة وباقة ومعلوما عند محمد ارتقاؤها"}
{"id": "MeM1C_10_02:K020", "doan": "قد تحررت هذه الخطابية بولس المذكور تحيرا في ٢٦ تموز سنة ٩٣١ الف وثمانيه"}
{"id": "MeM1C_10_02:K021", "doan": "وسبع وثلاثين"}
{"id": "Nasrallah-Al001-014f:K000", "doan": "٠٠"}
{"id": "Nasrallah-Al001-014f:K001", "doan": "الى الثمن\""}
{"id": "Nasrallah-Al001-014f:K002", "doan": "أما الصورة التي افقتها، ولم"}
{"id": "Nasrallah-Al001-014f:K003", "doan": "غاً  \" فهي صورة أمه، \" فامنها"}
{"id": "Nasrallah-Al001-014f:K004", "doan": "المخطأ: بالسعود \" حسن ما يصفها"}
{"id": "Nasrallah-Al001-014f:K005", "doan": "معه"}
{"id": "Nasrallah-Al001-014f:K006", "doan": "لقد سطت على لقرا نبع"}
{"id": "Nasrallah-Al001-014f:K007", "doan": "صفو"}
{"id": "Nasrallah-Al001-014f:K008", "doan": "لا يسهل على أي كاس وصفري،"}
{"id": "Nasrallah-Al001-014f:K009", "doan": "الثقافة التي اعتمدت، وكما سماها تاب"}
{"id": "Nasrallah-Al001-014f:K010", "doan": "بدله، حاول أن يخفف من أثقال"}
{"id": "Nasrallah-Al001-014f:K011", "doan": "طعولة، فلقه، جامعه، وحافله،"}
{"id": "Nasrallah-Al001-014f:K012", "doan": "جبل من الوصلة الغامضة."}
{"id": "Nasrallah-Al001-014f:K013", "doan": "ولم يكن سطراً عليها"}
{"id": "Nasrallah-Al001-014f:K014", "doan": "ان مواسم طفولتها، في المراة العالية"}
{"id": "Nasrallah-Al001-014f:K015", "doan": "لما يرى : دنه بها، المتشعة بالحمراء"}
{"id": "Nasrallah-Al001-014f:K016", "doan": "والبصرة"}
{"id": "Nasrallah-Al001-014h:K000", "doan": "فبعد، ثم انجزت ٥٠٠ مئت"}
{"id": "Nasrallah-Al001-014h:K001", "doan": ": احرى"}
{"id": "Nasrallah-Al001-014h:K002", "doan": "لكن ليلى عسران لم تفشا في"}
{"id": "Nasrallah-Al001-014h:K003", "doan": "مسرتي الأديبة، وقد خلفت من بعدها"}
{"id": "Nasrallah-Al001-014h:K004", "doan": "عشر روايات بدءا من العام 1960 حين"}
{"id": "Nasrallah-Al001-014h:K005", "doan": "ز - \"روايتها الأولى\" لن يموت عدا"}
{"id": "Nasrallah-Al001-014h:K006", "doan": "أبناء \"الغيوه\" وهو عملٌ"}
{"id": "Nasrallah-Al001-014h:K007", "doan": "مريد في أدنا الحديث ؛ كما أن المؤلفة"}
{"id": "Nasrallah-Al001-014h:K008", "doan": "يقدمها بجرأتها، وولو هذا الى مواطن"}
{"id": "Nasrallah-Al001-014h:K009", "doan": "أتتني الياس في المتألم، والذي"}
{"id": "Nasrallah-Al001-014h:K010", "doan": "كأنه الى حين"}
{"id": "Nasrallah-Al001-014h:K011", "doan": "وإحتراماً مع العلم،"}
{"id": "Nasrallah-Al001-014h:K012", "doan": "لم يدع لك التجربة أي مسا به الفريدة"}
{"id": "Nasrallah-Al001-034j:K000", "doan": "الثلاثا ١ - ٢ - ١٩٥٤"}
{"id": "Nasrallah-Al001-034j:K001", "doan": "نقاط المحرّرين"}
{"id": "Nasrallah-Al001-034j:K002", "doan": "ي"}
{"id": "Nasrallah-Al001-034j:K003", "doan": "١٠٠"}
{"id": "Nasrallah-Al001-034j:K004", "doan": "سالي، فزعات"}
{"id": "Nasrallah-Al001-034j:K005", "doan": "اليوم"}
{"id": "Nasrallah-Al001-034j:K006", "doan": "(١) -"}
{"id": "Nasrallah-Al001-034j:K007", "doan": "لى"}
{"id": "Nasrallah-Al001-034j:K008", "doan": "الخوري يوحنا حرب"}
{"id": "Nasrallah-Al001-034j:K009", "doan": "مجلس،"}
{"id": "Nasrallah-Al001-034j:K010", "doan": "\"العروة السادة\""}
{"id": "Nasrallah-Al001-034j:K011", "doan": "."}
{"id": "Nasrallah-Al001-034j:K012", "doan": "مطرة"}
{"id": "Nasrallah-Al001-034j:K013", "doan": "٥\""}
{"id": "Nasrallah-Al001-034j:K014", "doan": "لهُ عنه ما"}
