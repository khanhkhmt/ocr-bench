{"id": "AR53_02_213:K041", "doan": "و"}
{"id": "AR53_02_213:K042", "doan": "مالوقه"}
{"id": "AR53_02_213:K043", "doan": "٤"}
{"id": "AR53_02_213:K044", "doan": "ضاهر"}
{"id": "AR53_02_213:K045", "doan": "بكاف في لغة معروفة"}
{"id": "AR53_02_213:K046", "doan": "فيمن العزة إلى"}
{"id": "AR53_02_213:K047", "doan": "زكية"}
{"id": "AR53_02_213:K048", "doan": "ثلاث مؤامرات"}
{"id": "AR53_02_213:K049", "doan": "الزوجية"}
{"id": "AR53_02_213:K050", "doan": "تبعه . ."}
{"id": "AR53_02_213:K051", "doan": "أو في"}
{"id": "AR53_02_213:K052", "doan": "غير الوجه"}
{"id": "AR53_02_213:K053", "doan": "امين"}
{"id": "AR53_02_213:K054", "doan": "يطهية أو إفريقية"}
{"id": "AR53_02_213:K055", "doan": "و"}
{"id": "AR53_02_213:K056", "doan": "٢"}
{"id": "AR53_02_213:K057", "doan": "ذووي"}
{"id": "AR53_02_213:K058", "doan": "الى شرعة"}
{"id": "AR53_02_213:K059", "doan": "فيه"}
{"id": "AR53_02_213:K060", "doan": "تخوف"}
{"id": "AR53_02_213:K061", "doan": "وثلاث"}
{"id": "AR53_02_213:K062", "doan": "مطانيوس"}
{"id": "AR53_02_213:K063", "doan": "الياء والسين"}
{"id": "AR56_01_078_2:K000", "doan": "الكبير، فان قلت \"فهل عليك"}
{"id": "AR56_01_078_2:K001", "doan": "زيارة زحله ومعرفتها ولا يجدر بك"}
{"id": "AR56_01_078_2:K002", "doan": "أيها مواطني الاّ راك هذا شيء"}
{"id": "AR56_01_078_2:K003", "doan": "الصغير من دلائل الحياة في بلادك"}
{"id": "AR56_01_078_2:K004", "doan": "الشأنهم ما معنى عموم كتبك"}
{"id": "AR56_01_078_2:K005", "doan": "في المدن أغلظك في إتي"}
{"id": "AR56_01_078_2:K006", "doan": "أدرس مباديك : وعمدي بك -"}
{"id": "AR56_01_078_2:K007", "doan": "ارفع القدب وابيلهم إلى البحث."}
{"id": "AR56_01_078_2:K008", "doan": "قيل لي ان بشيء يتكلمك فيك"}
{"id": "AR56_01_078_2:K009", "doan": "وكنت غائباً في الجبل فلم أتمكن"}
{"id": "AR56_01_078_2:K010", "doan": "من الاطلاع ما تخرصوا في"}
{"id": "AR56_01_078_2:K011", "doan": "٢"}
{"id": "AR56_01_078_2:K012", "doan": "ولكنَّ أشدة الإمام وسوق"}
{"id": "AR56_01_078_2:K013", "doan": "ترك ما يفيد الكلام لولا"}
{"id": "AR56_01_078_2:K014", "doan": "الفراد"}
{"id": "AR56_01_078_2:K015", "doan": "اقبلك بشوقٍ على امل ان"}
{"id": "AR56_01_078_2:K016", "doan": "أن قلت \"لا\" بابول فرقة"}
{"id": "AR56_01_078_2:K017", "doan": "ارسلت لطائفة قبيل الى"}
{"id": "AR56_01_078_2:K018", "doan": "لا واردة هي زبد الى"}
{"id": "AR56_03_036:K000", "doan": "بسم الله الرحمن الرحيم"}
{"id": "AR56_03_036:K001", "doan": "من عبد العزيز بن عبد الرحمن الفيصل إلى حضرة المكرم الاستاذ أمين افندي الريحاني المحترم دام بقاه"}
{"id": "AR56_03_036:K002", "doan": "تحية وسلاما، وبعد فقد أخذت بيد المسرة كتابك المؤرخ ١٦ جمادى الثانية ١٣٤٢ وإني اشكرك على هذه ثقتك بنا"}
{"id": "AR56_03_036:K003", "doan": "كما أشكرك على خدماتك لقومك بكل ما تستطيع، أما صداقتي الطاهرة التي تعرفها بأأمن لم تتغير وبقدر هذه"}
{"id": "AR56_03_036:K004", "doan": "الصداقة كان العتب إنك تعرفنا يا أمين وتعرف مقدرتنا بالله كما تعرف جن بلاء جنودنا أن عزائمنا لا يغليها"}
{"id": "AR56_03_036:K005", "doan": "إلا إرادة الله، فما معنى تجويفنا بجمع علي وجيشه، إننا لم نقصد من نشر الكتاب الحظ من شأنك ولا النيل"}
{"id": "AR56_03_036:K006", "doan": "من كرامتك ولكن أردنا أن تعرف ويعرف العالم القاصي والداني أن القوم لا يملكون إلا كلمات ممجوفة وإن ما جمعوا"}
{"id": "AR56_03_036:K007", "doan": "لن يقف بحول الله وقوته أمام جند الله لقد فتحت لك قلبي يا أمي في كتابي المرسل مع العويني ولكنك استعملت"}
