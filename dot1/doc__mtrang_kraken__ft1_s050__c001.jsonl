{"id": "AR51_008:K020", "doan": "فقدوا"}
{"id": "AR51_008:K021", "doan": "الخميس"}
{"id": "AR51_008:K022", "doan": "٦ القيارة المتعددة الأوكار، تلك الغشارة التي"}
{"id": "AR51_008:K023", "doan": "ردو دنيته آيات وحيها، وذهب هو حر"}
{"id": "AR51_008:K024", "doan": "وانت"}
{"id": "AR51_008:K025", "doan": "الذي"}
{"id": "AR51_008:K026", "doan": "سموها، وكان هوميروس ابنها"}
{"id": "AR51_008:K027", "doan": "يوم الاحد"}
{"id": "AR51_008:K028", "doan": "وكان شكي"}
{"id": "AR53_02_213:K000", "doan": "لأنهم كانوا مؤمنين."}
{"id": "AR53_02_213:K001", "doan": "١٦ - يقادتهم والزعماء. ٢- خاضوا المعارك فيتعين ان"}
{"id": "AR53_02_213:K002", "doan": "... هو انتصار المغرب، وان في كنف مبادئ الثورة نخبني"}
{"id": "AR53_02_213:K003", "doan": "بيان"}
{"id": "AR53_02_213:K004", "doan": "الاثنين"}
{"id": "AR53_02_213:K005", "doan": "مكالمهم الوطنة وأن الأمم القومية"}
{"id": "AR53_02_213:K006", "doan": "والجيران والذين هم حولنا الا"}
{"id": "AR53_02_213:K007", "doan": "العامل القوة التي لوت الثورة، وضمنت لها النصر. فقد هؤلاء"}
{"id": "AR53_02_213:K008", "doan": "(١) ان الجهاد بين اعداء الدين واعداء الله، إن"}
{"id": "AR53_02_213:K009", "doan": "دور من"}
{"id": "AR53_02_213:K010", "doan": "الجمعة"}
{"id": "AR53_02_213:K011", "doan": "يصار على اللغو والإلحاد. إن في ذلك"}
{"id": "AR53_02_213:K012", "doan": "الزوار، وصّودا"}
{"id": "AR53_02_213:K013", "doan": "من الدعايات السياسية فهذا الزمان"}
{"id": "AR53_02_213:K014", "doan": "الانصار عن"}
{"id": "AR53_02_213:K015", "doan": "كل دعاية"}
{"id": "AR53_02_213:K016", "doan": "في"}
{"id": "AR53_02_213:K017", "doan": "الوهم أو النخداع"}
{"id": "AR53_02_213:K018", "doan": "الثلاثاء"}
{"id": "AR53_02_213:K019", "doan": "ان للتعاون"}
{"id": "AR53_02_213:K020", "doan": "الثلاثاء"}
{"id": "AR53_02_213:K021", "doan": "نعود الى جلتنا القبيات"}
{"id": "AR53_02_213:K022", "doan": "عكفت به بدبّة وها نحن"}
{"id": "AR53_02_213:K023", "doan": "فيك فتاني"}
{"id": "AR53_02_213:K024", "doan": "ظهر بعضها، والأمل كبير"}
{"id": "AR53_02_213:K025", "doan": "فطعنا جمال عمارة"}
{"id": "AR53_02_213:K026", "doan": "نصفي على الف"}
{"id": "AR53_02_213:K027", "doan": "٢"}
{"id": "AR53_02_213:K028", "doan": "الساعة ٢"}
{"id": "AR53_02_213:K029", "doan": "بدأ الانبياء"}
{"id": "AR53_02_213:K030", "doan": "الى اوانك على"}
{"id": "AR53_02_213:K031", "doan": "الاحد"}
{"id": "AR53_02_213:K032", "doan": "فعاد الزمان بنا"}
{"id": "AR53_02_213:K033", "doan": "نعود إلى احلة الفين"}
{"id": "AR53_02_213:K034", "doan": "هذه الاكفاء"}
{"id": "AR53_02_213:K035", "doan": "١/٢"}
{"id": "AR53_02_213:K036", "doan": "الحن والبدران"}
{"id": "AR53_02_213:K037", "doan": "السبت"}
{"id": "AR53_02_213:K038", "doan": "الساعة ١"}
{"id": "AR53_02_213:K039", "doan": "من كانعاتها السرية"}
{"id": "AR53_02_213:K040", "doan": "ربيع ٩ - رزق"}
