{"id": "AR53_02_213:K041", "doan": "٧"}
{"id": "AR53_02_213:K042", "doan": "اللون"}
{"id": "AR53_02_213:K043", "doan": "الجمعة"}
{"id": "AR53_02_213:K044", "doan": "الثلاثاء"}
{"id": "AR53_02_213:K045", "doan": "يكافن لغة معروفة"}
{"id": "AR53_02_213:K046", "doan": "عن الوحدة ال"}
{"id": "AR53_02_213:K047", "doan": "رضا"}
{"id": "AR53_02_213:K048", "doan": "لا تمسوكن"}
{"id": "AR53_02_213:K049", "doan": "زوجته"}
{"id": "AR53_02_213:K050", "doan": "تبعه عن الع"}
{"id": "AR53_02_213:K051", "doan": "الاثنين"}
{"id": "AR53_02_213:K052", "doan": "غير الوحدة"}
{"id": "AR53_02_213:K053", "doan": "زهير"}
{"id": "AR53_02_213:K054", "doan": "يمكنة أو افريقية"}
{"id": "AR53_02_213:K055", "doan": "و"}
{"id": "AR53_02_213:K056", "doan": "١"}
{"id": "AR53_02_213:K057", "doan": "دوبي"}
{"id": "AR53_02_213:K058", "doan": "إلى رسم"}
{"id": "AR53_02_213:K059", "doan": "؟"}
{"id": "AR53_02_213:K060", "doan": "شمس"}
{"id": "AR53_02_213:K061", "doan": "ثلاثاء"}
{"id": "AR53_02_213:K062", "doan": "انا"}
{"id": "AR53_02_213:K063", "doan": "البارد والساعة ١"}
{"id": "AR56_01_078_2:K000", "doan": "رجال ملك"}
{"id": "AR56_01_078_2:K001", "doan": "زيارة زحله ومراضا ولا يجدركن"}
{"id": "AR56_01_078_2:K002", "doan": "الى مصطفى الاربعاء هذا شيء"}
{"id": "AR56_01_078_2:K003", "doan": "الصغير من دلائل الحياة في لاوكن."}
{"id": "AR56_01_078_2:K004", "doan": "سنا فهم ما معنى عم كتاش"}
{"id": "AR56_01_078_2:K005", "doan": "في المكان. أعاظك منى أنني"}
{"id": "AR56_01_078_2:K006", "doan": "الدرس مبادئه؟ وعهدى من"}
{"id": "AR56_01_078_2:K007", "doan": "ارجح النهر واساله إلى البحث."}
{"id": "AR56_01_078_2:K008", "doan": "قيل لي أن انساني يتكلم فك"}
{"id": "AR56_01_078_2:K009", "doan": "وكنت عابسا في الجبل فلم أتمكن"}
{"id": "AR56_01_078_2:K010", "doan": "من الاطلاع ما نحرصا ونحرص"}
{"id": "AR56_01_078_2:K011", "doan": "٢"}
{"id": "AR56_01_078_2:K012", "doan": "ولكن القوة للامام وسعور"}
{"id": "AR56_01_078_2:K013", "doan": "ترك ما يفيد الكلام لولا"}
{"id": "AR56_01_078_2:K014", "doan": "الفرار"}
{"id": "AR56_01_078_2:K015", "doan": "أهلك شرف على أن اسأت"}
{"id": "AR56_01_078_2:K016", "doan": "الرءوس الأولى وهذه"}
{"id": "AR56_01_078_2:K017", "doan": "ارسله لحال الى"}
{"id": "AR56_01_078_2:K018", "doan": "الادارة وهي تسير الى"}
{"id": "AR56_03_036:K000", "doan": "بسم الله الرحمن الرحيم"}
{"id": "AR56_03_036:K001", "doan": "من عبد العزيز بن عبد الرحمن ال فيصل الى حضرة المكرم الاستاذ امين افندي الريحاني المحترم دام بقاه"}
{"id": "AR56_03_036:K002", "doan": "تحية وسلامات وبعد فقد أخذت بيد المسة كتابك المؤرخ ١٦ جمادى الثانية ١٣٤٢ وإني اشكك على حسن ثقتك بنا"}
{"id": "AR56_03_036:K003", "doan": "كما اشكرك على خدماتك لقومك بأمرين لم تتغير وبقدر هذه"}
{"id": "AR56_03_036:K004", "doan": "الصداقة كان العتب. إنك تعرفنا يا أمين وتعرف مقدار ثقتنا بالله كما تعرف حسن بلاء جنودنا أن عزائمنا لا يغلبها"}
{"id": "AR56_03_036:K005", "doan": "إلا إرادة الله. فما معنى تخوفنا بجمع علي وجيشه. إننا لم نقصد من نشر الكتاب الحط من شأنك ولا النيل"}
{"id": "AR56_03_036:K006", "doan": "من كرامتك ولكن اردنا ان تعرف ويعرف العالم القاصي والداني أن القوم لا يملكون إلا كلمات مجوفة وإن ما جمعوا"}
{"id": "AR56_03_036:K007", "doan": "لن يقف بحول الله وقوته أمام جند الله لقد فتحت لك قلبي يا امين في كتابي المرسل مع العويني ولكنك استعملته"}
