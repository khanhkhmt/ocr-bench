{"id": "kc0066_01_01_1873diary_165:V011", "doan": "وقديم بن تيم وفد الصيفي في Fedimus"}
{"id": "kc0066_01_01_1873diary_165:V012", "doan": "وبناء كنيسة عن قريب وجر المياه من النهر"}
{"id": "kc0066_01_01_1873diary_165:V013", "doan": "بتطاهل إلى البيوت أسوه بالهن وفي"}
{"id": "kc0066_01_01_1873diary_165:V014", "doan": "نيته أن يجعل هذه البلدة ٢٠٠ جم أملاك الأقطار"}
{"id": "kc0066_01_01_1873diary_170:V000", "doan": "كبار الموسى ١٩٠٥"}
{"id": "kc0066_01_01_1873diary_170:V001", "doan": "على شارع لاس بالماس للسكان ووراطا"}
{"id": "kc0066_01_01_1873diary_170:V002", "doan": "غرفة للنوم ومطبخ وحياة الدكاكين"}
{"id": "kc0066_01_01_1873diary_170:V003", "doan": "وما رأيكم يكون عنا لأنهم غبار وأعمالي"}
{"id": "kc0066_01_01_1873diary_170:V004", "doan": "الشراء في أخي في البركات قبله، وطاجر"}
{"id": "kc0066_01_01_1873diary_170:V005", "doan": "أبي رجل فرنسي الأصل كان يشتغل"}
{"id": "kc0066_01_01_1873diary_170:V006", "doan": "مستخدما عند خوان برعري في أول"}
{"id": "kc0066_01_01_1873diary_170:V007", "doan": "فيكتوريا والأجرة ٢٥ - ٤٠ شهري"}
{"id": "kc0066_01_01_1873diary_170:V008", "doan": "وفي ٢٠ ك١ : ١٩٠٥ وصل"}
{"id": "kc0066_01_01_1873diary_170:V009", "doan": "إلى أبي يوسف بن علي عبودي من"}
{"id": "kc0066_01_01_1873diary_170:V010", "doan": "يبرود فأقام عندنا يا عمنا ويتعلم"}
{"id": "kc0066_01_01_1873diary_170:V011", "doan": "لغة هل البلاد واسعة أو واسعة وحيانا"}
{"id": "kc0066_01_01_1873diary_170:V012", "doan": "الحمل بفتحه في أول يوم من"}
{"id": "kc0066_01_01_1873diary_170:V013", "doan": "السنة الجديدة ١٩٠٦"}
