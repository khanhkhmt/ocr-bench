{"id": "AR53_02_213:K041", "doan": "٧"}
{"id": "AR53_02_213:K042", "doan": "مالقه"}
{"id": "AR53_02_213:K043", "doan": "١"}
{"id": "AR53_02_213:K044", "doan": "٢\""}
{"id": "AR53_02_213:K045", "doan": "بما من لغة معروفة"}
{"id": "AR53_02_213:K046", "doan": "من العزة الى"}
{"id": "AR53_02_213:K047", "doan": "منه"}
{"id": "AR53_02_213:K048", "doan": "ثلاث مساوئن -"}
{"id": "AR53_02_213:K049", "doan": "الزوجية"}
{"id": "AR53_02_213:K050", "doan": "تبعد عن العز"}
{"id": "AR53_02_213:K051", "doan": "او..."}
{"id": "AR53_02_213:K052", "doan": "غير الوعة"}
{"id": "AR53_02_213:K053", "doan": "جهاز"}
{"id": "AR53_02_213:K054", "doan": "طينة أو افريقية"}
{"id": "AR53_02_213:K055", "doan": "و"}
{"id": "AR53_02_213:K056", "doan": "١"}
{"id": "AR53_02_213:K057", "doan": "ذوي"}
{"id": "AR53_02_213:K058", "doan": "الى شر"}
{"id": "AR53_02_213:K059", "doan": "؟"}
{"id": "AR53_02_213:K060", "doan": "تكون"}
{"id": "AR53_02_213:K061", "doan": "ثلاثاء"}
{"id": "AR53_02_213:K062", "doan": "فيها"}
{"id": "AR53_02_213:K063", "doan": "البارد والحر"}
{"id": "AR56_01_078_2:K000", "doan": "رجل ملك"}
{"id": "AR56_01_078_2:K001", "doan": "زيارة زحله ومزاحا ولا بخير سكن"}
{"id": "AR56_01_078_2:K002", "doan": "الى بعض الأراضي في هذا العهد،"}
{"id": "AR56_01_078_2:K003", "doan": "الصغير من دلائل الحياة في الأركان"}
{"id": "AR56_01_078_2:K004", "doan": "لئن افهم ما معنى عم لمثل"}
{"id": "AR56_01_078_2:K005", "doan": "في المدافن. أعاظك مني انني"}
{"id": "AR56_01_078_2:K006", "doan": "الأرض مبادئها ؟ وعهدى من"}
{"id": "AR56_01_078_2:K007", "doan": "ارجع الفنون وامسك إلى البحث."}
{"id": "AR56_01_078_2:K008", "doan": "قيل لي إن الشيء يتملك فك"}
{"id": "AR56_01_078_2:K009", "doan": "وكنت عابسا في الجبل فلم أتمكن"}
{"id": "AR56_01_078_2:K010", "doan": "من الاطلاع ما نحرصوا و"}
{"id": "AR56_01_078_2:K011", "doan": "٢\""}
{"id": "AR56_01_078_2:K012", "doan": "ولكنه اخذة للامام وسوق"}
{"id": "AR56_01_078_2:K013", "doan": "ترك ما يفيد الظلام لولا"}
{"id": "AR56_01_078_2:K014", "doan": "الافراد"}
{"id": "AR56_01_078_2:K015", "doan": "املك شوق على اس اس"}
{"id": "AR56_01_078_2:K016", "doan": "الى مكة ثم الى راوة ومن"}
{"id": "AR56_01_078_2:K017", "doan": "ارسله لطرف وصل الى"}
{"id": "AR56_01_078_2:K018", "doan": "الادارة وهي تسير الى"}
{"id": "AR56_03_036:K000", "doan": "ثم إن المحرم"}
{"id": "AR56_03_036:K001", "doan": "بن عبد العزيز بن عبد الرحمن الفيصل إلى حضرة المكرم الاستاذ أمين افندي الريحاني المحترم دام بقاه"}
{"id": "AR56_03_036:K002", "doan": "تحية وسلاما، وبعد فقد أخذت بيد المسرة كتابك المؤرخ ١٦ جمادى الثانية ١٣٤٤ وأني اشكرك على هذه ثقتك بنا"}
{"id": "AR56_03_036:K003", "doan": "كما أشرك على خدماتك لتوقعك بكل ما تستطيع. أما صداقتي الطاهرة التي تعرفها بأعين لم تتغير وبقدر هذه"}
{"id": "AR56_03_036:K004", "doan": "الصداقة كان العتب. إنك تعرفنا يا أمين وتعرف مقدار ثقتنا بالله كما تعرف حسن بلاء جنودنا أن عزائمنا لا يغلبها"}
{"id": "AR56_03_036:K005", "doan": "إلا إرادة الله، فما معنى تحيقنا بجمع علي وجيشه، إننا لم نقصد من نشر الكتاب الحط من شأنك ولا النيل"}
{"id": "AR56_03_036:K006", "doan": "من كرامتك ولكن أردنا أن نعرف ويعرف العالم القاصي والداني أن القوم لا يملكون إلا كلمات مجمعة وأن ما جمعوا"}
{"id": "AR56_03_036:K007", "doan": "لن يقف بحول الله وقوته أمام جند الله لقد فتحت لك قلبي يا أمي في كتابي المرسل مع العويني ولكنك استعملته"}
