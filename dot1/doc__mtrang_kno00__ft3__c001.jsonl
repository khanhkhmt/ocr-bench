{"id": "AR51_008:K020", "doan": "فقدوا"}
{"id": "AR51_008:K021", "doan": "النحيب"}
{"id": "AR51_008:K022", "doan": "ت القيثارة المتعددة الأوتار، تلك الغثارة التي"}
{"id": "AR51_008:K023", "doan": "ردد دنية آيات فيها، وذهب هؤلاء"}
{"id": "AR51_008:K024", "doan": "وانت"}
{"id": "AR51_008:K025", "doan": "الذي"}
{"id": "AR51_008:K026", "doan": "سمعها، وكان هوميروس ابتهاً"}
{"id": "AR51_008:K027", "doan": "ومها الا"}
{"id": "AR51_008:K028", "doan": "وكان شكياً"}
{"id": "AR53_02_213:K000", "doan": "لأنهم كانوا موقوفين، مكثو وعروته،"}
{"id": "AR53_02_213:K001", "doan": "القادتهم والزعماء: فاخضر الموارد فيتمنون أن"}
{"id": "AR53_02_213:K002", "doan": "بها هو انتصار المغرب، وان في تحقيق مبادئ الثورة تحقيق"}
{"id": "AR53_02_213:K003", "doan": "بيان"}
{"id": "AR53_02_213:K004", "doan": "شريف"}
{"id": "AR53_02_213:K005", "doan": "ومطالبهم الوطنية وأماهم القومية،"}
{"id": "AR53_02_213:K006", "doan": "والجبرية وما يلزمها هو إفادة الأسماء"}
{"id": "AR53_02_213:K007", "doan": "العامل القوة التي نولت الثورة، وضمنت لها النصر. فقد تصور"}
{"id": "AR53_02_213:K008", "doan": "آية، إن الجموع بين أعداء الدنيا واعداء الله، وإن"}
{"id": "AR53_02_213:K009", "doan": "دور من"}
{"id": "AR53_02_213:K010", "doan": "جورج"}
{"id": "AR53_02_213:K011", "doan": "يفار على اللفظ والإلحاد. إن في ذلك"}
{"id": "AR53_02_213:K012", "doan": "الوآء، وصعوداً"}
{"id": "AR53_02_213:K013", "doan": "من الدعايات السياسية في هذا الزمان"}
{"id": "AR53_02_213:K014", "doan": "الانتصار على"}
{"id": "AR53_02_213:K015", "doan": "الدعاية"}
{"id": "AR53_02_213:K016", "doan": "فيه"}
{"id": "AR53_02_213:K017", "doan": "الوهم أو اخداع"}
{"id": "AR53_02_213:K018", "doan": "بتة"}
{"id": "AR53_02_213:K019", "doan": "أن للنحو"}
{"id": "AR53_02_213:K020", "doan": "وفسح لهما على مرتين في ١٨ شباط ١٩١٢"}
{"id": "AR53_02_213:K021", "doan": "نعود الى جلتنا القبيه،"}
{"id": "AR53_02_213:K022", "doan": "عطفية، بدائية ونهاية ومتى"}
{"id": "AR53_02_213:K023", "doan": "ينظر قلبك"}
{"id": "AR53_02_213:K024", "doan": "، ظلم بعضها، والأول كبيره"}
{"id": "AR53_02_213:K025", "doan": "قطعنا جبال غمارة"}
{"id": "AR53_02_213:K026", "doan": "تقصي على الفا"}
{"id": "AR53_02_213:K027", "doan": "٢"}
{"id": "AR53_02_213:K028", "doan": "5"}
{"id": "AR53_02_213:K029", "doan": "بدأ الانبياء، و"}
{"id": "AR53_02_213:K030", "doan": "الى اوائله على"}
{"id": "AR53_02_213:K031", "doan": "الاحد"}
{"id": "AR53_02_213:K032", "doan": "فعاد الزمان فيا"}
{"id": "AR53_02_213:K033", "doan": "نعود الى المحلة لنعيش"}
{"id": "AR53_02_213:K034", "doan": "في هذه الأسماء"}
{"id": "AR53_02_213:K035", "doan": "١١٢"}
{"id": "AR53_02_213:K036", "doan": "المن والبدات"}
{"id": "AR53_02_213:K037", "doan": "٥"}
{"id": "AR53_02_213:K038", "doan": "والتغية"}
{"id": "AR53_02_213:K039", "doan": "من نافعاتها العربية"}
{"id": "AR53_02_213:K040", "doan": "بتاعه - رزقك"}
