{"id": "MeM1C_10_02:K017", "doan": "تكون شفيعة هذا الموقف وملتهة له من ابنها الحبيب المجازاة الجسيمة"}
{"id": "MeM1C_10_02:K018", "doan": "عوضا عن هذا الخير القاصد أن يبديه مجد الله وإفادة للقريب ولكني"}
{"id": "MeM1C_10_02:K019", "doan": "يكون هذا الناسين نافذا ونابتا ومعلما تابعه الجميع ارتقاؤنا به"}
{"id": "MeM1C_10_02:K020", "doan": "قد تحررت هذه الخطابية بيد بولس المذكور عزيرا في تموز سنة ٣٤١ الف وثمانيه"}
{"id": "MeM1C_10_02:K021", "doan": "وسبع وثلاثين صلاة"}
{"id": "Nasrallah-Al001-014f:K000", "doan": "١\""}
{"id": "Nasrallah-Al001-014f:K001", "doan": "\"الحالتين\""}
{"id": "Nasrallah-Al001-014f:K002", "doan": "أما الصورة التي رافقتها، وطم"}
{"id": "Nasrallah-Al001-014f:K003", "doan": "فأو، فهي صورة أُمكأً \" قامتها"}
{"id": "Nasrallah-Al001-014f:K004", "doan": "المغطاة بالسعود \"حسب ما تصفى"}
{"id": "Nasrallah-Al001-014f:K005", "doan": "يغةً"}
{"id": "Nasrallah-Al001-014f:K006", "doan": "لقد سطت ليلى لقرأتها"}
{"id": "Nasrallah-Al001-014f:K007", "doan": "هو"}
{"id": "Nasrallah-Al001-014f:K008", "doan": "لا يسهل على أيّ كاتب وصغير،"}
{"id": "Nasrallah-Al001-014f:K009", "doan": "باشفاية التي اعتمدتها، ونماها كانت"}
{"id": "Nasrallah-Al001-014f:K010", "doan": "بذلك، حاول أن تخفّف من أثقال"}
{"id": "Nasrallah-Al001-014f:K011", "doan": "طعولة، قلقة، خائفة، وحاملة"}
{"id": "Nasrallah-Al001-014f:K012", "doan": "جبل من أتت له الغامضة"}
{"id": "Nasrallah-Al001-014f:K013", "doan": "ولم يكن سطه عليه"}
{"id": "Nasrallah-Al001-014f:K014", "doan": "أن تواجه طفولتها، في المرأة العاكسة"}
{"id": "Nasrallah-Al001-014f:K015", "doan": "لياتها : ذئبها، المثمرة بالجرأة"}
{"id": "Nasrallah-Al001-014f:K016", "doan": "والصراحة."}
{"id": "Nasrallah-Al001-014h:K000", "doan": "فيها، ثم انجزت أرداءه، وفشلتُ"}
{"id": "Nasrallah-Al001-014h:K001", "doan": "في أخرى"}
{"id": "Nasrallah-Al001-014h:K002", "doan": "لكن ليلى عسيران لم تفشل في"}
{"id": "Nasrallah-Al001-014h:K003", "doan": "سيرتها الأدبية، وقد خلّفت من بعدها"}
{"id": "Nasrallah-Al001-014h:K004", "doan": "عشر روايات بدءا من العام 1960 حين"}
{"id": "Nasrallah-Al001-014h:K005", "doan": "أحد روايتها الأولى \"لن نموت غدا\""}
{"id": "Nasrallah-Al001-014h:K006", "doan": "وأشهر بكتابها \"الغيبوبة\" وهو عملٌ"}
{"id": "Nasrallah-Al001-014h:K007", "doan": "فريد في أدبنا الحديث ؛ كما أن المؤلفة"}
{"id": "Nasrallah-Al001-014h:K008", "doan": "تفردت برأيتها، وولج بها إلى بواظن"}
{"id": "Nasrallah-Al001-014h:K009", "doan": "الآتيين الإنساني المتألم، والذي"}
{"id": "Nasrallah-Al001-014h:K010", "doan": "كانته الى حين"}
{"id": "Nasrallah-Al001-014h:K011", "doan": "وإخلاصاً فيها لقلعها،"}
{"id": "Nasrallah-Al001-014h:K012", "doan": "لم يدع تلك التجربة الإنسانية الفريدة"}
{"id": "Nasrallah-Al001-034j:K000", "doan": "كنت ادير في منهم"}
{"id": "Nasrallah-Al001-034j:K001", "doan": "نقادة المحرّرين"}
{"id": "Nasrallah-Al001-034j:K002", "doan": "أي..."}
{"id": "Nasrallah-Al001-034j:K003", "doan": "١٠ ض و /٢٦ ض"}
{"id": "Nasrallah-Al001-034j:K004", "doan": "شالي، مرّعان"}
{"id": "Nasrallah-Al001-034j:K005", "doan": "\"اليوم\""}
{"id": "Nasrallah-Al001-034j:K006", "doan": "٧٥٥"}
{"id": "Nasrallah-Al001-034j:K007", "doan": "ريال"}
{"id": "Nasrallah-Al001-034j:K008", "doan": "الخوري يوحنا حرب"}
{"id": "Nasrallah-Al001-034j:K009", "doan": "بمكتب،"}
{"id": "Nasrallah-Al001-034j:K010", "doan": "في \"العروة الساذجة\""}
{"id": "Nasrallah-Al001-034j:K011", "doan": "الخوري يوحنا حرب"}
{"id": "Nasrallah-Al001-034j:K012", "doan": "خطة"}
{"id": "Nasrallah-Al001-034j:K013", "doan": "٥٠٢"}
{"id": "Nasrallah-Al001-034j:K014", "doan": "لهُ عن من"}
