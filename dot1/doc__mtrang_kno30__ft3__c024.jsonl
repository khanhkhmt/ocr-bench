{"id": "YAL2A_14_01:K015", "doan": "إلى لحم أبا ديلات أم سليم وطعام أديب ونحوه في الجاهلية"}
{"id": "YAL2A_14_01:K016", "doan": "مع ليم وحيات ابن العم مخايل بن بك طرزا في دوافعه"}
{"id": "YS_1D_070e:K000", "doan": "بمشيئة للاهل والملة والوطن ولكن الشعب قائم معه"}
{"id": "YS_1D_070e:K001", "doan": "وهي أيضا ضحى بنفسه أمامهم والآن تصرخ أهل مصر: قلبي"}
{"id": "YS_1D_070e:K002", "doan": "رغلول: وفي فريد أن نرفع راية الأرز ونصرة بصوت حي وأصوات"}
{"id": "YS_1D_070e:K003", "doan": "تمام: فليعش الاستاذ السَودا."}
{"id": "YS_1D_070e:K004", "doan": "افيرأ ارجوك ان تقبل ثيابنا اللائقة بمقامك"}
{"id": "YS_1D_070e:K005", "doan": "ودمت شمًا للعمل والحرية."}
{"id": "YS_1D_070e:K006", "doan": "١٥"}
{"id": "YS_2F_015b:K000", "doan": "السبت"}
{"id": "YS_2F_015b:K001", "doan": "16"}
{"id": "YS_2F_015b:K002", "doan": "النبي صلى الله عليه وسلم"}
{"id": "YS_2F_015b:K003", "doan": "الخيل حقيقة"}
{"id": "YS_2F_015b:K004", "doan": "٢٠"}
{"id": "YS_2F_015b:K005", "doan": "الامال"}
{"id": "YS_2F_015b:K006", "doan": "في العدد"}
{"id": "YS_2F_015b:K007", "doan": "مجال الطموح"}
{"id": "YS_2F_015b:K008", "doan": "إلى، إلى"}
{"id": "YS_2F_015b:K009", "doan": "6"}
{"id": "YS_2F_015b:K010", "doan": "٤٠"}
{"id": "YS_2F_015b:K011", "doan": "عبد، الى"}
{"id": "YS_2F_015b:K012", "doan": "البطء"}
{"id": "YS_2F_015b:K013", "doan": "الاسف"}
{"id": "YS_2F_015b:K014", "doan": "ن،"}
{"id": "YS_2F_015b:K015", "doan": "الحب"}
{"id": "YS_2F_015b:K016", "doan": "وما أوسع"}
{"id": "YS_2F_015b:K017", "doan": "طرب في زهرة الصب"}
{"id": "YS_2F_015b:K018", "doan": "احلام"}
{"id": "YS_4A_011j:K000", "doan": "الكوفة 1925 م، وازرتكير"}
{"id": "YS_4A_011j:K001", "doan": "الناس في وهاهم اهعلم"}
{"id": "YS_4A_011j:K002", "doan": "."}
{"id": "YS_4A_011j:K003", "doan": "الحقيقة كام وسن لهم خطأ"}
{"id": "YS_4A_011j:K004", "doan": "ولا تدعهم ينشئوا الظن من غير سبب."}
{"id": "YS_4A_011j:K005", "doan": "سوء التفاهم وضم العقبة في المسائل"}
{"id": "YS_4A_011j:K006", "doan": "السياسة."}
{"id": "YS_4A_011j:K007", "doan": "الآخرة من جهة ما يأتي:"}
{"id": "YS_4A_011j:K008", "doan": "لا أنت ولا إن ولا أخطىء ولا أحد من الذين"}
{"id": "YS_4A_011j:K009", "doan": "مستقلة لهذا لطمع بمركز معين في لبنان"}
{"id": "YS_4A_011j:K010", "doan": "ربك وذووه"}
{"id": "YS_4A_011j:K011", "doan": "١٠٩"}
{"id": "YS_4A_011j:K012", "doan": "عدد ١"}
{"id": "YS_4A_011j:K013", "doan": "ومنقوش وثقه اكتفى بخصره"}
{"id": "kc0061_01_04_19210417_001:K000", "doan": "3"}
{"id": "kc0061_01_04_19210417_001:K001", "doan": "Mardi"}
{"id": "kc0061_01_04_19210417_001:K002", "doan": "في الحبيب جوع حفظه لولى"}
{"id": "kc0061_01_04_19210417_001:K003", "doan": "قلت ماذا لا تنهى لها والقائمة"}
{"id": "kc0061_01_04_19210417_001:K004", "doan": "حسني جورج وسل للشيخ علي بقيمة ماية ريال"}
{"id": "kc0061_01_04_19210417_001:K005", "doan": "(دولار) أميركاني يكون عندك علم أن هذا التحرر هو"}
{"id": "kc0061_01_04_19210417_001:K006", "doan": "خارج عن نظام المكاتبة بشأنه علاوة عن التحارير الذي أرسلها لك"}
{"id": "kc0061_01_04_19210417_001:K007", "doan": "في كل أسبوع واحد هذا مخصص للشك وهو يزور شيوبيك"}
