{"id": "YAL2A_14_01:K015", "doan": "إلى لحم أبلات - أم سليم وام إدريس وعطا حمدي  في (٧)"}
{"id": "YAL2A_14_01:K016", "doan": "مع لف وجيارة امة العم على كل ركن من ملكه لا يردها دوافعهم"}
{"id": "YS_1D_070e:K000", "doan": "سماعة لاهل والملة هالوطن ولكن الشعب قام معه"}
{"id": "YS_1D_070e:K001", "doan": "وهي أيضا ضحى بنفسه أمامهم والآن تصرف أهل مصر: فليبي"}
{"id": "YS_1D_070e:K002", "doan": "رغلول: ولى فريد أن نرفع راية الأرز ولصرح بصوت حي وأجماع"}
{"id": "YS_1D_070e:K003", "doan": "تام: فليعش الاستاذ السَودا."}
{"id": "YS_1D_070e:K004", "doan": "افيرأ ارجوك ان تقبل ثباتنا اللائق بمقامك"}
{"id": "YS_1D_070e:K005", "doan": "ووقت شمًا للعمل والحرية."}
{"id": "YS_1D_070e:K006", "doan": "الاَذ"}
{"id": "YS_2F_015b:K000", "doan": "الخوري يوحنا حبيب"}
{"id": "YS_2F_015b:K001", "doan": "16"}
{"id": "YS_2F_015b:K002", "doan": "الشكلات"}
{"id": "YS_2F_015b:K003", "doan": "الخيال..."}
{"id": "YS_2F_015b:K004", "doan": "(٥)"}
{"id": "YS_2F_015b:K005", "doan": "الامال"}
{"id": "YS_2F_015b:K006", "doan": "الساعة ١٠"}
{"id": "YS_2F_015b:K007", "doan": "محل الطمع"}
{"id": "YS_2F_015b:K008", "doan": "اللي الى"}
{"id": "YS_2F_015b:K009", "doan": "6"}
{"id": "YS_2F_015b:K010", "doan": "السبت"}
{"id": "YS_2F_015b:K011", "doan": "عبد، الى"}
{"id": "YS_2F_015b:K012", "doan": "البطء"}
{"id": "YS_2F_015b:K013", "doan": "الاسف"}
{"id": "YS_2F_015b:K014", "doan": "و"}
{"id": "YS_2F_015b:K015", "doan": "الحب"}
{"id": "YS_2F_015b:K016", "doan": "وما وسع"}
{"id": "YS_2F_015b:K017", "doan": "لي في زهر الصيف"}
{"id": "YS_2F_015b:K018", "doan": "احلام"}
{"id": "YS_4A_011j:K000", "doan": "الجهة ماذا يقصد الشاعر"}
{"id": "YS_4A_011j:K001", "doan": "الناس في وهاهم افعلهم او"}
{"id": "YS_4A_011j:K002", "doan": "العنيسي"}
{"id": "YS_4A_011j:K003", "doan": "الحقيقة كما هو . من لهم حظاً"}
{"id": "YS_4A_011j:K004", "doan": "ولا تدعهم يشعوا الظن من غير"}
{"id": "YS_4A_011j:K005", "doan": "سوء التفاهم وهم العامة في المأكل"}
{"id": "YS_4A_011j:K006", "doan": "الساعة ١٠"}
{"id": "YS_4A_011j:K007", "doan": "أو من صنعا ماشى."}
{"id": "YS_4A_011j:K008", "doan": "لا أنت ولا أن ولا أخلاق ولا أحد من الذين"}
{"id": "YS_4A_011j:K009", "doan": "مستقلا لهذا الاسم لطمع عزيمة معدته في كن"}
{"id": "YS_4A_011j:K010", "doan": "الكل وذووه"}
{"id": "YS_4A_011j:K011", "doan": "- ٩"}
{"id": "YS_4A_011j:K012", "doan": "عدد ١"}
{"id": "YS_4A_011j:K013", "doan": "وتقع وثق اكتوبر ١٩٠١"}
{"id": "kc0061_01_04_19210417_001:K000", "doan": "؟"}
{"id": "kc0061_01_04_19210417_001:K001", "doan": "Mardi"}
{"id": "kc0061_01_04_19210417_001:K002", "doan": "في الحبيب جوهم حفظه المولى"}
{"id": "kc0061_01_04_19210417_001:K003", "doan": "قديدت لا تشهد لها والف تحية"}
{"id": "kc0061_01_04_19210417_001:K004", "doan": "حسني جودة وسل لك طيه شك بقيمة ماية ريال"}
{"id": "kc0061_01_04_19210417_001:K005", "doan": "(رواد) إسرائيليين، يكون عندك علم أن هذا التحرر هو"}
{"id": "kc0061_01_04_19210417_001:K006", "doan": "خارج عن نظام المكاتبة بشأنه علاوة عن التحارير الذي أرسلها لك"}
{"id": "kc0061_01_04_19210417_001:K007", "doan": "في كل أسبوع واحد هذا مخصص للشك وهو ترور شويوك"}
