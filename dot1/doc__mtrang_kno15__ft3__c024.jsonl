{"id": "YAL2A_14_01:K015", "doan": "إلى لحم أبا دلأت - أم سليم وامرأة اربد وعطل صحيحة أي (٤)"}
{"id": "YAL2A_14_01:K016", "doan": "مع ليم وصيات ابن العم مخايل ربيط طالب لا يحرمني دوامهم"}
{"id": "YS_1D_070e:K000", "doan": "بمشيئة لا إله إلا هو والملة والوطن ولكن الشعب قائم معه"}
{"id": "YS_1D_070e:K001", "doan": "وهي أيضا ضحى بنفسه أمامهم والآن تصرخ أهل مصر: قلبي"}
{"id": "YS_1D_070e:K002", "doan": "رغلول: ولكني فريد أن نرفع راية الأرز ونصرخ بصوت حي وأجماحه"}
{"id": "YS_1D_070e:K003", "doan": "تمام: فليعش الاستاذ السَودا."}
{"id": "YS_1D_070e:K004", "doan": "افيدا ارجوك ان تقبل ثباتنا اللائق بتمامك"}
{"id": "YS_1D_070e:K005", "doan": "ودمت شمًا للعمل والحرية."}
{"id": "YS_1D_070e:K006", "doan": "١٥"}
{"id": "YS_2F_015b:K000", "doan": "الخوري يوحنا حرب"}
{"id": "YS_2F_015b:K001", "doan": "16"}
{"id": "YS_2F_015b:K002", "doan": "الذكاة اتت في"}
{"id": "YS_2F_015b:K003", "doan": "الخيال"}
{"id": "YS_2F_015b:K004", "doan": "٢٠"}
{"id": "YS_2F_015b:K005", "doan": "الامال"}
{"id": "YS_2F_015b:K006", "doan": "المعنى"}
{"id": "YS_2F_015b:K007", "doan": "مجال الطموح"}
{"id": "YS_2F_015b:K008", "doan": "الله الى"}
{"id": "YS_2F_015b:K009", "doan": "6"}
{"id": "YS_2F_015b:K010", "doan": "الجمعة"}
{"id": "YS_2F_015b:K011", "doan": "عبد، الى"}
{"id": "YS_2F_015b:K012", "doan": "البطء"}
{"id": "YS_2F_015b:K013", "doan": "الاسف"}
{"id": "YS_2F_015b:K014", "doan": "ن،"}
{"id": "YS_2F_015b:K015", "doan": "الحب"}
{"id": "YS_2F_015b:K016", "doan": "وما وسع"}
{"id": "YS_2F_015b:K017", "doan": "طب في نهدة الصباح"}
{"id": "YS_2F_015b:K018", "doan": "احلام"}
{"id": "YS_4A_011j:K000", "doan": "الجعفر  ماذا ء \" من ارشير"}
{"id": "YS_4A_011j:K001", "doan": "الناس في وهاهم افعلهم او"}
{"id": "YS_4A_011j:K002", "doan": "الخوري يوحنا حرب"}
{"id": "YS_4A_011j:K003", "doan": "الحقيقة كامحة، من لهم حظاً"}
{"id": "YS_4A_011j:K004", "doan": "ولا تدعهم يشعوا الظن من غير سبب."}
{"id": "YS_4A_011j:K005", "doan": "سوء التفاهم وصم العصبة في المسائل"}
{"id": "YS_4A_011j:K006", "doan": "السبعة"}
{"id": "YS_4A_011j:K007", "doan": "افهمه من هذه ما تالي:"}
{"id": "YS_4A_011j:K008", "doan": "لا أنت ولا أن ولا أخطى ولا أحد من الذين"}
{"id": "YS_4A_011j:K009", "doan": "مستقلا لهذا لطمع عزيمة معينة في لبنان"}
{"id": "YS_4A_011j:K010", "doan": "ديك وذووه"}
{"id": "YS_4A_011j:K011", "doan": "١٠٤"}
{"id": "YS_4A_011j:K012", "doan": "عدد ١"}
{"id": "YS_4A_011j:K013", "doan": "وتنقر ولثق اكتفى بكم"}
{"id": "kc0061_01_04_19210417_001:K000", "doan": "3"}
{"id": "kc0061_01_04_19210417_001:K001", "doan": "Mardi"}
{"id": "kc0061_01_04_19210417_001:K002", "doan": "في الحبيب جوع حفظه لموسى"}
{"id": "kc0061_01_04_19210417_001:K003", "doan": "قبلت ماءة لا شهي لها والقا ثمة  . ."}
{"id": "kc0061_01_04_19210417_001:K004", "doan": "حسني جورج وسلل لك طيه شك بقيمة ماية ريال"}
{"id": "kc0061_01_04_19210417_001:K005", "doan": "(دولار أميركاني) يكون عندك علم أن هذا التحرر هو"}
{"id": "kc0061_01_04_19210417_001:K006", "doan": "خارج عن نظام المكاتبة بشأنه علاوة عن التحارير الذي أرسلها لك"}
{"id": "kc0061_01_04_19210417_001:K007", "doan": "في كل أسبوع واحد هذا مخصص للشك وهو يزور شيوخ"}
