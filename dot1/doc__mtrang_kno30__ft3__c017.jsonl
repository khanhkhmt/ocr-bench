{"id": "MeM1C_10_02:K017", "doan": "تكون شفيعة هذا الموقف وملتته له من أنها الحبيب المجازاة الجسيمة"}
{"id": "MeM1C_10_02:K018", "doan": "عوضا عن هذا الخير القاصد أن يبديه مجد الله وإفادة للقريب ولكني"}
{"id": "MeM1C_10_02:K019", "doan": "يكون هذا الناسين نافذا وثابتا ومعلوما عند الجميع ارتقاؤنا به"}
{"id": "MeM1C_10_02:K020", "doan": "قد تحررت هذه الخطابية بولس المذكور تحيرا في ٢٨ تموز سنة ٩٣٤ الف وثمانيه"}
{"id": "MeM1C_10_02:K021", "doan": "وسبع وثلاثين"}
{"id": "Nasrallah-Al001-014f:K000", "doan": "١"}
{"id": "Nasrallah-Al001-014f:K001", "doan": "\"الحالتين\""}
{"id": "Nasrallah-Al001-014f:K002", "doan": "أما الصورة التي رافقتها، ولم"}
{"id": "Nasrallah-Al001-014f:K003", "doan": "غاية، فهي صورة أُمكأ \"قامتها"}
{"id": "Nasrallah-Al001-014f:K004", "doan": "المغطاة بالسعود \"حسب ما تصفى"}
{"id": "Nasrallah-Al001-014f:K005", "doan": "فيه"}
{"id": "Nasrallah-Al001-014f:K006", "doan": "لقد سقطت ليلى لقرأتها"}
{"id": "Nasrallah-Al001-014f:K007", "doan": "صوتُ"}
{"id": "Nasrallah-Al001-014f:K008", "doan": "لا يسهل على أيّ عابب وصغير،"}
{"id": "Nasrallah-Al001-014f:K009", "doan": "باشفا فيه، التي اعتمدتها، وكنما تهات"}
{"id": "Nasrallah-Al001-014f:K010", "doan": "بذلك، حاول أن تخفّف من أثقال"}
{"id": "Nasrallah-Al001-014f:K011", "doan": "طعولة، حائفة، وحاملة"}
{"id": "Nasrallah-Al001-014f:K012", "doan": "جبل من الأتلة العاقصة"}
{"id": "Nasrallah-Al001-014f:K013", "doan": "ولم يكن سطراً عليها"}
{"id": "Nasrallah-Al001-014f:K014", "doan": "أن تواجه طفولتها، في المرأة العاكسة"}
{"id": "Nasrallah-Al001-014f:K015", "doan": "لما ترى : د نهيبها، المتشمعة بالمجرأة"}
{"id": "Nasrallah-Al001-014f:K016", "doan": "والصراحة."}
{"id": "Nasrallah-Al001-014h:K000", "doan": "فبعد، ثم أنجزت ١٥٠، ومثلثُ"}
{"id": "Nasrallah-Al001-014h:K001", "doan": "أحرى"}
{"id": "Nasrallah-Al001-014h:K002", "doan": "لكن ليلى عسبران لم تفشل في"}
{"id": "Nasrallah-Al001-014h:K003", "doan": "مسيرتها الأدبية، وقد خلقت من بعدها"}
{"id": "Nasrallah-Al001-014h:K004", "doan": "عشر روايات بدءا من العام 1960 حين"}
{"id": "Nasrallah-Al001-014h:K005", "doan": "أدت روايتها الأولى \"لن تموت غداً\""}
{"id": "Nasrallah-Al001-014h:K006", "doan": "وانتهاء بكتاب \"الغيبوبة\" وهو عملٌ"}
{"id": "Nasrallah-Al001-014h:K007", "doan": "فريد في أدبنا الحديث ؛ كما أن المؤلفة"}
{"id": "Nasrallah-Al001-014h:K008", "doan": "نفرت برأسها، وولجوا إلى بواطن"}
{"id": "Nasrallah-Al001-014h:K009", "doan": "الآليات الإنساني المتألم، والذي"}
{"id": "Nasrallah-Al001-014h:K010", "doan": "كأنه الى حين"}
{"id": "Nasrallah-Al001-014h:K011", "doan": "وإخيراً في لقلك،"}
{"id": "Nasrallah-Al001-014h:K012", "doan": "لم يدع تلك التجربة الإنسانية الفريدة"}
{"id": "Nasrallah-Al001-034j:K000", "doan": "كنت ادي 8 صوم"}
{"id": "Nasrallah-Al001-034j:K001", "doan": "نقابة المحرّرين"}
{"id": "Nasrallah-Al001-034j:K002", "doan": "زاعي"}
{"id": "Nasrallah-Al001-034j:K003", "doan": "١٠٠"}
{"id": "Nasrallah-Al001-034j:K004", "doan": "تتالي، فرّعنا ان"}
{"id": "Nasrallah-Al001-034j:K005", "doan": "اليوم"}
{"id": "Nasrallah-Al001-034j:K006", "doan": "١٠٠٠"}
{"id": "Nasrallah-Al001-034j:K007", "doan": "لي"}
{"id": "Nasrallah-Al001-034j:K008", "doan": "الخوري يوحنا حرب"}
{"id": "Nasrallah-Al001-034j:K009", "doan": "بمجلس،"}
{"id": "Nasrallah-Al001-034j:K010", "doan": "ز، القروة الساذجة"}
{"id": "Nasrallah-Al001-034j:K011", "doan": "٢٠24/١٠/٥"}
{"id": "Nasrallah-Al001-034j:K012", "doan": "مطرة"}
{"id": "Nasrallah-Al001-034j:K013", "doan": "٥٠٢"}
{"id": "Nasrallah-Al001-034j:K014", "doan": "لهُ عنه ما"}
