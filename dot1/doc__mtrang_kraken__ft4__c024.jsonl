{"id": "YAL2A_14_01:K015", "doan": "إلى لثم أيديات - أم سليم وام اديب وسوى طالبيهما  في (٧)"}
{"id": "YAL2A_14_01:K016", "doan": "معها لهم وحياتهم امهم الوف على كل ركن طالب لا يرقي دوافعهم"}
{"id": "YS_1D_070e:K000", "doan": "بشخصة لاهل وملكة والوطن ولكن الشعب قام معه"}
{"id": "YS_1D_070e:K001", "doan": "وهم أيضا حتى ينقذه أمامهم والآن تصرخ أهل مصر: فلي"}
{"id": "YS_1D_070e:K002", "doan": "رغلول: وكي فريد أن نرفع راية الأرز ونصرح بصوت حي وأجماع"}
{"id": "YS_1D_070e:K003", "doan": "تام: فليعش الاستاذ السَودا."}
{"id": "YS_1D_070e:K004", "doan": "أخيرا ارجوك ان تقبل ثيابنا اللائقة بمقامك"}
{"id": "YS_1D_070e:K005", "doan": "ووقت شمًا للعمل والحريمة"}
{"id": "YS_1D_070e:K006", "doan": "١٤"}
{"id": "YS_2F_015b:K000", "doan": "السبت"}
{"id": "YS_2F_015b:K001", "doan": "١٤"}
{"id": "YS_2F_015b:K002", "doan": "الذكورة السابقة"}
{"id": "YS_2F_015b:K003", "doan": "الخيال..."}
{"id": "YS_2F_015b:K004", "doan": "(٥)"}
{"id": "YS_2F_015b:K005", "doan": "الأملي"}
{"id": "YS_2F_015b:K006", "doan": "البعد"}
{"id": "YS_2F_015b:K007", "doan": "محال الطموح"}
{"id": "YS_2F_015b:K008", "doan": "إلى إلى"}
{"id": "YS_2F_015b:K009", "doan": "6"}
{"id": "YS_2F_015b:K010", "doan": "السبت"}
{"id": "YS_2F_015b:K011", "doan": "بمد، الى"}
{"id": "YS_2F_015b:K012", "doan": "البطء"}
{"id": "YS_2F_015b:K013", "doan": "الاسف"}
{"id": "YS_2F_015b:K014", "doan": "ن"}
{"id": "YS_2F_015b:K015", "doan": "الحب"}
{"id": "YS_2F_015b:K016", "doan": "وما وسع"}
{"id": "YS_2F_015b:K017", "doan": "لي في زهرة العنب"}
{"id": "YS_2F_015b:K018", "doan": "أحلام"}
{"id": "YS_4A_011j:K000", "doan": "آه مني يا ابا انتشار"}
{"id": "YS_4A_011j:K001", "doan": "الناس في وهاهم اهملهم او"}
{"id": "YS_4A_011j:K002", "doan": "الوطنية، السيادة القومية، الاستقلال .."}
{"id": "YS_4A_011j:K003", "doan": "الحقيقة كما هي. من لهم حظاً"}
{"id": "YS_4A_011j:K004", "doan": "ولا تدعهم تسَوء الظن من غير"}
{"id": "YS_4A_011j:K005", "doan": "سوء التفاهم وهم العامة في المآل"}
{"id": "YS_4A_011j:K006", "doan": "الساعة ١٠"}
{"id": "YS_4A_011j:K007", "doan": "أو من حسن ما على"}
{"id": "YS_4A_011j:K008", "doan": "لا أنت ولا أنا ولا اخوته ولا أحد من الذين"}
{"id": "YS_4A_011j:K009", "doan": "مستقلا، الا في لطمع عزته معه في لبنان"}
{"id": "YS_4A_011j:K010", "doan": "الكل وذووه"}
{"id": "YS_4A_011j:K011", "doan": "١٠٤"}
{"id": "YS_4A_011j:K012", "doan": "عدد ١"}
{"id": "YS_4A_011j:K013", "doan": "متفق وثق اكيد نحوه"}
{"id": "kc0061_01_04_19210417_001:K000", "doan": "2"}
{"id": "kc0061_01_04_19210417_001:K001", "doan": "Mardi"}
{"id": "kc0061_01_04_19210417_001:K002", "doan": "فيجيب جواب حضره المولى"}
{"id": "kc0061_01_04_19210417_001:K003", "doan": "قدت ثلاثة لا شهري لها والف ثمنة"}
{"id": "kc0061_01_04_19210417_001:K004", "doan": "حسنى جودة ورسل لك طيه شك بقيمة ماية ريال"}
{"id": "kc0061_01_04_19210417_001:K005", "doan": "(دولار) امريكي. يكون عندك علم أن هذا التحرر هو"}
{"id": "kc0061_01_04_19210417_001:K006", "doan": "خارج عن نظام الكائنة بشأنه علاوة عن التحارير الذي أرسلها لك"}
{"id": "kc0061_01_04_19210417_001:K007", "doan": "في كل أسبوع واحد هذا خص للكثي وهو ترور شهود"}
