{"id": "AR53_02_213:K041", "doan": "٧"}
{"id": "AR53_02_213:K042", "doan": "مالقه"}
{"id": "AR53_02_213:K043", "doan": "١"}
{"id": "AR53_02_213:K044", "doan": "٢"}
{"id": "AR53_02_213:K045", "doan": "بما من لغة معروفة"}
{"id": "AR53_02_213:K046", "doan": "في الرحلة الى"}
{"id": "AR53_02_213:K047", "doan": "زمن"}
{"id": "AR53_02_213:K048", "doan": "ثلاث مساكن -"}
{"id": "AR53_02_213:K049", "doan": "الزوجية"}
{"id": "AR53_02_213:K050", "doan": "تبعد الع"}
{"id": "AR53_02_213:K051", "doan": "او"}
{"id": "AR53_02_213:K052", "doan": "غير الوغة"}
{"id": "AR53_02_213:K053", "doan": "جهاز"}
{"id": "AR53_02_213:K054", "doan": "بضعة او افريقية"}
{"id": "AR53_02_213:K055", "doan": "و"}
{"id": "AR53_02_213:K056", "doan": "١٠"}
{"id": "AR53_02_213:K057", "doan": "ذوي"}
{"id": "AR53_02_213:K058", "doan": "الى شر"}
{"id": "AR53_02_213:K059", "doan": "؟"}
{"id": "AR53_02_213:K060", "doan": "متحوف"}
{"id": "AR53_02_213:K061", "doan": "غيره"}
{"id": "AR53_02_213:K062", "doan": "ميشال"}
{"id": "AR53_02_213:K063", "doan": "البارد والحر"}
{"id": "AR56_01_078_2:K000", "doan": "مبارك بن عبد الله بن مروان بن موسى بن مالك بن عيسى بن موسى بن مالك بن موس"}
{"id": "AR56_01_078_2:K001", "doan": "زيارة زحله ومعرفتها ولا يجهد سَلكه"}
{"id": "AR56_01_078_2:K002", "doan": "الى موطن الا راد هذا شيء"}
{"id": "AR56_01_078_2:K003", "doan": "الصغير من دلائل الحياة في لاكستان"}
{"id": "AR56_01_078_2:K004", "doan": "الشافع ما على عم كاتبك"}
{"id": "AR56_01_078_2:K005", "doan": "في المدافن، أعاطك مني انني"}
{"id": "AR56_01_078_2:K006", "doan": "الدرس مبادئه ؛ وعمومها من"}
{"id": "AR56_01_078_2:K007", "doan": "ارجع المقدسي واسلمه الى البحث."}
{"id": "AR56_01_078_2:K008", "doan": "قيل لي ان المشتى يتملك فك"}
{"id": "AR56_01_078_2:K009", "doan": "وكنت عابسا في الجبل فلم أتمكن"}
{"id": "AR56_01_078_2:K010", "doan": "من الاطلاع ما يخرصوا و"}
{"id": "AR56_01_078_2:K011", "doan": "٢"}
{"id": "AR56_01_078_2:K012", "doan": "ولكن القوة للإمام وسوق"}
{"id": "AR56_01_078_2:K013", "doan": "ترك ما يفيد الكلام لولا"}
{"id": "AR56_01_078_2:K014", "doan": "الفرار"}
{"id": "AR56_01_078_2:K015", "doan": "املك شوف على اس اس"}
{"id": "AR56_01_078_2:K016", "doan": "الرءية في \"الآيات\" من سورة"}
{"id": "AR56_01_078_2:K017", "doan": "ارسله لغيره فصل الى"}
{"id": "AR56_01_078_2:K018", "doan": "لادارة ومجيء زبد الى"}
{"id": "AR56_03_036:K000", "doan": "ثم إن الرجل يحرم"}
{"id": "AR56_03_036:K001", "doan": "من عبد العزيز بن عبد الرحمن الفيصل إلى حضرة المكرم الاستاذ أمين افندي الريحاني المحترم دام بقاه"}
{"id": "AR56_03_036:K002", "doan": "تحية وسلاما، وبعد فقد أخذت بيد المسحة كتابك المؤرخ ١٣٤٢ وإني اشكك على حسن ثقتك بها"}
{"id": "AR56_03_036:K003", "doan": "كما أشكرك على خدماتك لقومك بكل ما تستطيع، أما صداقتي الطاهرة التي تعرفها بأأمن لم تتغير وبقدر هذه"}
{"id": "AR56_03_036:K004", "doan": "الصداقة كان العتب إنك تعرفنا يا أمين وتعرف مقدار ثقتنا بالله كما تعرف حسن بلاء جنودنا أن عزا عمنا لا يفعلها"}
{"id": "AR56_03_036:K005", "doan": "إلا إرادة الله، فما معنى تخفيفنا بجمع علي وجيشه، إننا لم نقصد من نشر الكتاب الحط من شأنك ولا النيل"}
{"id": "AR56_03_036:K006", "doan": "من كرامتك ولكن أردنا أن تعرف ويعرف العالم القاصي والداني أن القوم لا يملكون إلا كلمات ممجوفة وإن ما جمعوا"}
{"id": "AR56_03_036:K007", "doan": "لن يقف بحول الله وقوته أمام جند الله لقد فتحت لك قلبي يا أمين في كتابي المرسل مع العويني ولكنك استعملته"}
