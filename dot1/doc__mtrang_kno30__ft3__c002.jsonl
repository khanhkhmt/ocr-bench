{"id": "AR53_02_213:K041", "doan": "v"}
{"id": "AR53_02_213:K042", "doan": "مالوقه"}
{"id": "AR53_02_213:K043", "doan": "١٤"}
{"id": "AR53_02_213:K044", "doan": "الثلاثاء"}
{"id": "AR53_02_213:K045", "doan": "بما من لغة معروفة"}
{"id": "AR53_02_213:K046", "doan": "في منع الصرة الى"}
{"id": "AR53_02_213:K047", "doan": "زكية"}
{"id": "AR53_02_213:K048", "doan": "ثلاث سنوات"}
{"id": "AR53_02_213:K049", "doan": "الزوجية"}
{"id": "AR53_02_213:K050", "doan": "تبعه"}
{"id": "AR53_02_213:K051", "doan": "القريب"}
{"id": "AR53_02_213:K052", "doan": "غير الوجه"}
{"id": "AR53_02_213:K053", "doan": "امين"}
{"id": "AR53_02_213:K054", "doan": "الهيئة الإفريقية"}
{"id": "AR53_02_213:K055", "doan": "و"}
{"id": "AR53_02_213:K056", "doan": "٥"}
{"id": "AR53_02_213:K057", "doan": "ذوي"}
{"id": "AR53_02_213:K058", "doan": "الى ترى"}
{"id": "AR53_02_213:K059", "doan": "في"}
{"id": "AR53_02_213:K060", "doan": "متحف"}
{"id": "AR53_02_213:K061", "doan": "ثلاثا"}
{"id": "AR53_02_213:K062", "doan": "وغلب"}
{"id": "AR53_02_213:K063", "doan": "الياء والسين"}
{"id": "AR56_01_078_2:K000", "doan": "مبارك بن عبد الله بن مسعود"}
{"id": "AR56_01_078_2:K001", "doan": "زيارة زحله ومعرفتها ولا يجدر بك"}
{"id": "AR56_01_078_2:K002", "doan": "أبا موسي الا راعى هذا شيء"}
{"id": "AR56_01_078_2:K003", "doan": "الصغير من دلائل الحياة في بلادك"}
{"id": "AR56_01_078_2:K004", "doan": "شافهم ما معنى عموم كتبك"}
{"id": "AR56_01_078_2:K005", "doan": "في المدافعة، أعاظك في أتى"}
{"id": "AR56_01_078_2:K006", "doan": "أدرس مباديك : وعمدي بك"}
{"id": "AR56_01_078_2:K007", "doan": "ارفع المئتين وابيلهم الى البحث."}
{"id": "AR56_01_078_2:K008", "doan": "قيل لي ان عشقي يتملك قلبك"}
{"id": "AR56_01_078_2:K009", "doan": "وكنت غائبا في الجبل فلم أتمكن"}
{"id": "AR56_01_078_2:K010", "doan": "من الاطلاع ما تخرصوا في"}
{"id": "AR56_01_078_2:K011", "doan": "٢"}
{"id": "AR56_01_078_2:K012", "doan": "ولكنَّ أسرة الإمام وسوق"}
{"id": "AR56_01_078_2:K013", "doan": "ترك ما يفيد الكلام لولا"}
{"id": "AR56_01_078_2:K014", "doan": "الفراد"}
{"id": "AR56_01_078_2:K015", "doan": "اقبلك بشوقٍ على امل ان"}
{"id": "AR56_01_078_2:K016", "doan": "الرقة والرؤية فهذه اول مرة"}
{"id": "AR56_01_078_2:K017", "doan": "ارسله لطرفه فصل الى"}
{"id": "AR56_01_078_2:K018", "doan": "لا واردة وهي تسير الى"}
{"id": "AR56_03_036:K000", "doan": "ثم إن الرجل يحرم"}
{"id": "AR56_03_036:K001", "doan": "من عبد العزيز بن عبد الرحمن الفيصل إلى حضرة المكرم الاستاذ أمين افندي الريحاني المحترم دام بقاه"}
{"id": "AR56_03_036:K002", "doan": "تحية وسلاما، وبعد فقد أخذت بيد المسرة كتابك المؤرخ ١٦ جمادى الثانية ١٣٤٤ وإني اشكك على حسين تقتك بن"}
{"id": "AR56_03_036:K003", "doan": "كما أشكرك على خدماتك لقومك بكل ما تستطيع، أما صداقتي الطاهرة التي تعرفها بأأمن لم تتغير وبقدر هذه"}
{"id": "AR56_03_036:K004", "doan": "الصداقة كان العتب إنك تعرفنا يا أمين وتعرف مقدرتنا بالله كما تعرف جن بلاء جنودنا أن عزائمنا لا يغليها"}
{"id": "AR56_03_036:K005", "doan": "إلا إرادة الله، فما معنى تجويئنا بجمع علي وجيشه، إننا لم نقصد من نشر الكتاب الحظ من شأنك ولا النيل"}
{"id": "AR56_03_036:K006", "doan": "من كرامتك ولكن أردنا أن تعرف ويعرف العالم القاصي والداني أن القوم لا يملكون إلا كلمات ممجوفة وإن ما جمعوا"}
{"id": "AR56_03_036:K007", "doan": "لن يقف بحول الله وقوته أمام جند الله لقد فتحت لك قلبي يا أمين في كتابي المرسل مع العويني ولكنك استعملت"}
