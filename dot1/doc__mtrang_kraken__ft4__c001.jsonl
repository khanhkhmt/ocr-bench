{"id": "AR51_008:K020", "doan": "فقدوا"}
{"id": "AR51_008:K021", "doan": "النحوي"}
{"id": "AR51_008:K022", "doan": "ت القيثارة المتعددة الأوتار، تلك الغثارة التي"}
{"id": "AR51_008:K023", "doan": "ردو دنية آيات فيها، وذهب هوغو حرب"}
{"id": "AR51_008:K024", "doan": "وانت"}
{"id": "AR51_008:K025", "doan": "ذل الغير"}
{"id": "AR51_008:K026", "doan": "سمها، وكان هوميروس اسماً"}
{"id": "AR51_008:K027", "doan": "ومعها الا"}
{"id": "AR51_008:K028", "doan": "وكان شك"}
{"id": "AR53_02_213:K000", "doan": "... لأنهم كانوا مؤمنين"}
{"id": "AR53_02_213:K001", "doan": "١٦٠ - بقاؤهم والزعماء : فاخذوا المعارك فيتعين ان"}
{"id": "AR53_02_213:K002", "doan": "ب، هو انتصار المغرب، وان في تحقيق مبادئ الثورة تحقيق"}
{"id": "AR53_02_213:K003", "doan": "بيان"}
{"id": "AR53_02_213:K004", "doan": "شعرت في"}
{"id": "AR53_02_213:K005", "doan": "مصالحهم الوطنية وأماكن القومية،"}
{"id": "AR53_02_213:K006", "doan": "والجبرية في بالزم هو إفادة الأسماء"}
{"id": "AR53_02_213:K007", "doan": "المؤمل القوة التي لو تمت الثورة، وضمنت لها النصر، فقد هؤلاء"}
{"id": "AR53_02_213:K008", "doan": "آية، إن الجهود في أعداء الدين، واعداء الله، وإن"}
{"id": "AR53_02_213:K009", "doan": "مورغن"}
{"id": "AR53_02_213:K010", "doan": "ب 6"}
{"id": "AR53_02_213:K011", "doan": "يصار على العفو والالحاد. ان في ذلك"}
{"id": "AR53_02_213:K012", "doan": "الدار، وصودوا"}
{"id": "AR53_02_213:K013", "doan": "من الدعايات السياسية في هذا الزمان"}
{"id": "AR53_02_213:K014", "doan": "الانتصار على"}
{"id": "AR53_02_213:K015", "doan": "على دعاية"}
{"id": "AR53_02_213:K016", "doan": "فيه"}
{"id": "AR53_02_213:K017", "doan": "الوهم أو الخداع"}
{"id": "AR53_02_213:K018", "doan": "شمسه ١"}
{"id": "AR53_02_213:K019", "doan": "ان للتعاون"}
{"id": "AR53_02_213:K020", "doan": "الساعة ١٠"}
{"id": "AR53_02_213:K021", "doan": "نعود إلى جلتنا القبيات،"}
{"id": "AR53_02_213:K022", "doan": "حلفية، بداية وهاية،"}
{"id": "AR53_02_213:K023", "doan": "يظهر قياس"}
{"id": "AR53_02_213:K024", "doan": "ظهر بعضها، والأمل كبير"}
{"id": "AR53_02_213:K025", "doan": "قطعنا حبال غماره"}
{"id": "AR53_02_213:K026", "doan": "تغطى على الفراش"}
{"id": "AR53_02_213:K027", "doan": "٢\""}
{"id": "AR53_02_213:K028", "doan": "٢)"}
{"id": "AR53_02_213:K029", "doan": "أي الانبياء، و"}
{"id": "AR53_02_213:K030", "doan": "الى اولئك على"}
{"id": "AR53_02_213:K031", "doan": "الاحد"}
{"id": "AR53_02_213:K032", "doan": "فعاد الزمان بنا"}
{"id": "AR53_02_213:K033", "doan": "نعود الى المحلة القديمة"}
{"id": "AR53_02_213:K034", "doan": "في هذه الاعياد"}
{"id": "AR53_02_213:K035", "doan": "//٢//"}
{"id": "AR53_02_213:K036", "doan": "المن والبدان"}
{"id": "AR53_02_213:K037", "doan": "٢\""}
{"id": "AR53_02_213:K038", "doan": "شفيقة"}
{"id": "AR53_02_213:K039", "doan": "النافع منها سارية"}
{"id": "AR53_02_213:K040", "doan": "بتاعة - روك"}
