{"id": "MeM1C_10_02:K017", "doan": "تكون سقعة هذا الموقف وملتزمة له من ابنها الحبيب المحجازة الحسنة"}
{"id": "MeM1C_10_02:K018", "doan": "عوضا عن هذا الخير القاصدان يبديه محمد الله وإفادة للغريب. ولكني"}
{"id": "MeM1C_10_02:K019", "doan": "كمو في هذا الناسين يا فذا وناقا ومعلوماتنا عدنا نحن ارتفاونا به"}
{"id": "MeM1C_10_02:K020", "doan": "قد عثرت هذه الأطرابية بولس المذكور تحريرا في ٦ تموز سنة ٩٣١ الف وثمانمايه"}
{"id": "MeM1C_10_02:K021", "doan": "وسبع وثلاثين صحبا"}
{"id": "Nasrallah-Al001-014f:K000", "doan": "٧"}
{"id": "Nasrallah-Al001-014f:K001", "doan": "الى الثمن\"."}
{"id": "Nasrallah-Al001-014f:K002", "doan": "أما الصورة التي امقتها ولم"}
{"id": "Nasrallah-Al001-014f:K003", "doan": "غاية فهي صورة أمريكاء \"خامنها\""}
{"id": "Nasrallah-Al001-014f:K004", "doan": "المخطاة بالسوء حسب ما صعقها."}
{"id": "Nasrallah-Al001-014f:K005", "doan": "عمة"}
{"id": "Nasrallah-Al001-014f:K006", "doan": "لقد سطت على لقرّائها"}
{"id": "Nasrallah-Al001-014f:K007", "doan": "صبو"}
{"id": "Nasrallah-Al001-014f:K008", "doan": "لا سهل على ايتاك وصغيري"}
{"id": "Nasrallah-Al001-014f:K009", "doan": "ما شفاه التي اعتمدت، وكما سما كان"}
{"id": "Nasrallah-Al001-014f:K010", "doan": "رديء، حاول أن يخفف من أثقال"}
{"id": "Nasrallah-Al001-014f:K011", "doan": "طعولة، فلفه، حاحق، وحامله"}
{"id": "Nasrallah-Al001-014f:K012", "doan": "جعلا من الو سله العامعه"}
{"id": "Nasrallah-Al001-014f:K013", "doan": "ولم يكن عليه"}
{"id": "Nasrallah-Al001-014f:K014", "doan": "ان يوم طفولتها، على المرء العالة"}
{"id": "Nasrallah-Al001-014f:K015", "doan": "لما سرى: د نهيبها المشوه بالمحراة"}
{"id": "Nasrallah-Al001-014f:K016", "doan": "والصبر طام."}
{"id": "Nasrallah-Al001-014h:K000", "doan": "منها، ثم انجزت ٥٠٠٠ شيك"}
{"id": "Nasrallah-Al001-014h:K001", "doan": "أمريكا"}
{"id": "Nasrallah-Al001-014h:K002", "doan": "لكن ليلى عمران لم تفشل في"}
{"id": "Nasrallah-Al001-014h:K003", "doan": "معرتها الأدمة. وقد خلفت من بعدها"}
{"id": "Nasrallah-Al001-014h:K004", "doan": "عشر روات بدءا من العام ١٩٦٥ صين"}
{"id": "Nasrallah-Al001-014h:K005", "doan": "ذ - روايتها الأولى \"لن يموت عدا\""}
{"id": "Nasrallah-Al001-014h:K006", "doan": "استهاء كتاب \"الغيوم\" وهو عملُ"}
{"id": "Nasrallah-Al001-014h:K007", "doan": "مر بدي او منا الحدت ؛ كما ان المعلمة"}
{"id": "Nasrallah-Al001-014h:K008", "doan": "نقد وسبراع وولوها الى مواطن"}
{"id": "Nasrallah-Al001-014h:K009", "doan": "الناس اليساف المثاله، والذي"}
{"id": "Nasrallah-Al001-014h:K010", "doan": "كأنني إلى حس"}
{"id": "Nasrallah-Al001-014h:K011", "doan": "وإحصاها مع العلماء"}
{"id": "Nasrallah-Al001-014h:K012", "doan": "لم يدع لك التجربة أي سابق الفريدة"}
{"id": "Nasrallah-Al001-034j:K000", "doan": "الثلاثاء ١- ٢- ١٩٥٤"}
{"id": "Nasrallah-Al001-034j:K001", "doan": "نقاط المحرّرين"}
{"id": "Nasrallah-Al001-034j:K002", "doan": "٢"}
{"id": "Nasrallah-Al001-034j:K003", "doan": "١٠"}
{"id": "Nasrallah-Al001-034j:K004", "doan": "سالي، من عسان"}
{"id": "Nasrallah-Al001-034j:K005", "doan": "السوم"}
{"id": "Nasrallah-Al001-034j:K006", "doan": "- ١) -"}
{"id": "Nasrallah-Al001-034j:K007", "doan": "١"}
{"id": "Nasrallah-Al001-034j:K008", "doan": "الانسة"}
{"id": "Nasrallah-Al001-034j:K009", "doan": "مجلس"}
{"id": "Nasrallah-Al001-034j:K010", "doan": "العروة الساذجة"}
{"id": "Nasrallah-Al001-034j:K011", "doan": "٥"}
{"id": "Nasrallah-Al001-034j:K012", "doan": "مطرة"}
{"id": "Nasrallah-Al001-034j:K013", "doan": "٥"}
{"id": "Nasrallah-Al001-034j:K014", "doan": "في منع ما"}
